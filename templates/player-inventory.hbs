<div class="player-inventory">
  {{!-- Header with actor name. Speed is shown by the encumbrance bar and the
        convoy bar below — a third copy here was the same finalSpeed value. --}}
  <div class="inv-header dw-window-head">
    <i class="fas fa-person-rays"></i>
    <h2 class="actor-name">{{actor.name}}</h2>
    {{!-- Only worth showing once something has actually been left behind --}}
    {{#if droppedCount}}
    <button type="button" data-action="toggleDroppedVisibility" class="btn-toolbar btn-dropped-toggle"
            title="{{#if hideDropped}}{{localizeN "DOLMENWOOD.Inv.Dropped.ShowHint" droppedCount}}{{else}}{{localizeN "DOLMENWOOD.Inv.Dropped.HideHint" droppedCount}}{{/if}}">
      <i class="fas {{#if hideDropped}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
      {{#if hideDropped}}{{localize "DOLMENWOOD.Inv.Dropped.ShowLabel" n=droppedCount}}{{else}}{{localize "DOLMENWOOD.Inv.Dropped.HideLabel" n=droppedCount}}{{/if}}
    </button>
    {{/if}}
    {{!-- Opens the shop with this character already selected as the buyer —
          which is why it is worth having here and not only on the toolbar. --}}
    {{#if mayOpenGenericShop}}
    <button type="button" data-action="openShop" class="btn-toolbar btn-shop"
            title="{{localize "DOLMENWOOD.Inv.Shop.Hint" name=actor.name}}">
      <i class="fas fa-store"></i> {{localize "DOLMENWOOD.Inv.Shop.Label"}}
    </button>
    {{/if}}
    {{!-- The other half of the character: the sheet's own Inventory button
          comes back here, so the two windows point at each other. --}}
    <button type="button" data-action="openSheet" class="btn-toolbar btn-sheet"
            title="{{localize "DOLMENWOOD.Inv.Sheet.Hint" name=actor.name}}">
      <i class="fas fa-scroll"></i> {{localize "DOLMENWOOD.Inv.Sheet.Label"}}
    </button>
    {{!-- What the pack is worth, for the Referee alone. Beside the name because
          it is a fact about this character, not a control. --}}
    {{#if isGM}}{{#if totalValue}}
    <span class="inv-total-value" title="{{localize "DOLMENWOOD.Inv.TotalValue.Hint"}}">
      <i class="fas fa-sack-dollar"></i> {{totalValue}}
    </span>
    {{/if}}{{/if}}
  </div>

  {{!-- The party's pace, on a line of its own with nothing else in it (Dolmenmaster,
        2026-08-31: *"ich hätte gerne, dass in der reihe mit dem convoy speed
        nichts anderes mehr ist"*). It answers a different question from the two
        boxes below it — what the whole party marches at, not what this one
        character carries — and while it shared a column with the load bars it
        read as their caption rather than as a statement of its own. --}}
  {{#unless isSharedStore}}
  <div class="convoy-speed-bar">
    <span class="convoy-label"><i class="fas fa-route"></i> {{localize "DOLMENWOOD.Inv.Convoy.Label"}}</span>
    {{!-- Everything tied at that pace, not one example of it. The line is held
          to one line by the CSS, which cuts it with an ellipsis where the window
          is too narrow — the tooltip always has the full list, with the owner of
          each animal (Dolmenmaster, 2026-08-31). --}}
    {{#if partyConvoy}}
    <span class="convoy-final {{speedColor partyConvoy.speed}}"
          title="{{#if (gt partyConvoy.slowest.length 1)}}{{localize "DOLMENWOOD.Inv.Convoy.HintTied" tied=partyConvoy.slowest.length slowest=(convoySlowest partyConvoy.slowest true)}}{{else}}{{localize "DOLMENWOOD.Inv.Convoy.Hint" slowest=(convoySlowest partyConvoy.slowest true)}}{{/if}}">
      {{speedLabel partyConvoy.speed}}
      <span class="convoy-slowest">— {{convoySlowest partyConvoy.slowest}}</span>
    </span>
    {{else}}
    <span class="convoy-final {{speedColor encumbrance.footSpeed}}"
          title="{{localize "DOLMENWOOD.Inv.Convoy.Alone"}}">
      {{speedLabel encumbrance.footSpeed}}
    </span>
    {{/if}}
  </div>
  {{/unless}}

  {{!-- Load and purse side by side, in that order of appetite: the load bars
        need a track to draw, the coins need least of all. Two boxes of the same
        make and the same height, so the pair reads as one band (Dolmenmaster,
        2026-08-31). They were three full-width blocks stacked up, which is most
        of what made the window so wide. --}}
  <div class="inv-summary">

  {{!-- Encumbrance bars. The shared store carries nothing itself — a load bar
        against the personal 1,600 wt cap would be meaningless there. --}}
  {{#unless isSharedStore}}
  <div class="inv-summary-cell inv-summary-load">
    {{> encumbrance-bar encumbrance=encumbrance encMode=encMode}}
  </div>
  {{/unless}}

  {{!-- Coins — total summary only; per-zone purses appear in each zone section
        below. Last and narrowest of the three: a purse is four short figures. --}}
  <section class="inv-summary-cell inv-coins">
    <div class="coins-header">
      <h3><i class="fas fa-coins"></i> {{localize "DOLMENWOOD.Inv.Coins.Title"}}</h3>
      {{#if isGM}}
      <button type="button" data-action="grantCoins" class="btn-grant-coins" title="{{localize "DOLMENWOOD.Inv.Coins.GrantHint"}}">
        <i class="fas fa-gift"></i> {{localize "DOLMENWOOD.Coins.Grant.Button"}}
      </button>
      {{/if}}
      {{#if canGive}}
      <button type="button" data-action="giveCoins" class="btn-give-coins" title="{{localize "DOLMENWOOD.Inv.Coins.GiveHint"}}">
        <i class="fas fa-hand-holding-heart"></i> {{localize "DOLMENWOOD.Give.Button"}}
      </button>
      {{/if}}
    </div>
    {{> coin-display inventory=inventory encumbrance=encumbrance canEdit=canEdit}}
  </section>

  </div>{{!-- /.inv-summary --}}

  {{!-- Weight mode: Unsorted FIRST (before Equipped), then Equipped --}}
  {{#if (eq encMode "weight")}}
  {{#if showUnsorted}}
  <section class="inv-zone-section inv-zone-unsorted">
    <div class="zone-header">
      <h3><i class="fas fa-exclamation-triangle"></i> {{localize "DOLMENWOOD.Inv.Unsorted.Title"}}</h3>
      <span class="zone-count" style="color:orange;">{{localize "DOLMENWOOD.Inv.Unsorted.Hint"}}</span>
    </div>
    {{> inventory-zone items=zones.stowed zone="stowed" canEdit=canEdit canGive=canGive isGM=isGM isOwner=isOwner canAddItem=false extraZones=extraZones encMode=encMode}}
    {{> zone-coin-purse zoneId="stowed" zoneCoins=(lookup coinsByZone "stowed") canEdit=canEdit isOwner=isOwner}}
  </section>
  {{/if}}
  {{/if}}

  {{!-- Belt Pouch Zone (slot mode only) --}}
  {{#unless (eq encMode "weight")}}
  <section class="inv-zone-section">
    <div class="zone-header">
      <h3><i class="fas fa-gem"></i> {{localize "DOLMENWOOD.Zone.BeltPouch"}}</h3>
      <span class="zone-count {{#if (gt encumbrance.tinyCount 10)}}over-limit{{/if}}">
        {{encumbrance.tinyCount}} / 10
        {{#if (gt encumbrance.tinyOverflow 0)}}
        <span class="overflow-badge" title="{{localize "DOLMENWOOD.Inv.Tiny.OverflowHint" count=encumbrance.tinyOverflow}}">
          {{localize "DOLMENWOOD.Inv.Tiny.Overflow" count=encumbrance.tinyOverflow}}
        </span>
        {{/if}}
      </span>
    </div>
    {{> inventory-zone items=zones.tiny zone="tiny" canEdit=canEdit canGive=canGive isGM=isGM isOwner=isOwner canAddItem=canAddItem extraZones=extraZones encMode=encMode}}
    {{> zone-coin-purse zoneId="tiny" zoneCoins=(lookup coinsByZone "tiny") canEdit=canEdit isOwner=isOwner}}
  </section>
  {{/unless}}

  {{!-- Equipped Zone --}}
  <section class="inv-zone-section">
    <div class="zone-header">
      <h3><i class="fas fa-shield-alt"></i> {{localize "DOLMENWOOD.Zone.Equipped"}}</h3>
      {{#if (eq encMode "weight")}}
      <span class="zone-count">{{localize "DOLMENWOOD.Inv.Wt" n=encumbrance.equippedWeight}}</span>
      {{else}}
      <span class="zone-count">{{localize "DOLMENWOOD.Inv.SlotCount" n=encumbrance.equippedSlots}}</span>
      {{/if}}
    </div>
    {{> inventory-zone items=zones.equipped zone="equipped" canEdit=canEdit canGive=canGive isGM=isGM isOwner=isOwner canAddItem=canAddItem extraZones=extraZones encMode=encMode}}
    {{> zone-coin-purse zoneId="equipped" zoneCoins=(lookup coinsByZone "equipped") canEdit=canEdit isOwner=isOwner}}
  </section>

  {{!-- Stowed Zone (slot mode only) --}}
  {{#unless (eq encMode "weight")}}
  <section class="inv-zone-section">
    <div class="zone-header">
      <h3><i class="fas fa-backpack"></i> {{localize "DOLMENWOOD.Zone.Stowed"}}</h3>
      <span class="zone-count">{{localize "DOLMENWOOD.Inv.SlotCount" n=encumbrance.stowedSlots}}
        {{#if (gt encumbrance.coinSlots 0)}}
        <span class="coin-slot-note" title="{{localizeN "DOLMENWOOD.Inv.CoinSlotsHint" encumbrance.coinSlots}}">
          {{localize "DOLMENWOOD.Inv.CoinSlots" count=encumbrance.coinSlots}}
        </span>
        {{/if}}
      </span>
    </div>
    {{> inventory-zone items=zones.stowed zone="stowed" canEdit=canEdit canGive=canGive isGM=isGM isOwner=isOwner canAddItem=canAddItem extraZones=extraZones encMode=encMode}}
    {{> zone-coin-purse zoneId="stowed" zoneCoins=(lookup coinsByZone "stowed") canEdit=canEdit isOwner=isOwner}}
  </section>
  {{/unless}}

  {{!-- Storage Zones (weight mode: backpack, sack, etc.) --}}
  {{#if (eq encMode "weight")}}
  {{#each storageZones}}
  {{> zone-section zone=this zoneCoins=(lookup ../coinsByZone this.id) canEdit=../canEdit canGive=../canGive canGiveZone=../canGiveZone canShare=../canShare isGM=../isGM isOwner=../isOwner extraZones=../extraZones encMode=../encMode}}
  {{/each}}
  {{/if}}

  {{!-- Vehicle/Animal Zones --}}
  {{#each vehicleZones}}
  {{> zone-section zone=this zoneCoins=(lookup ../coinsByZone this.id) canEdit=../canEdit canGive=../canGive canGiveZone=../canGiveZone canShare=../canShare isGM=../isGM isOwner=../isOwner extraZones=../extraZones encMode=../encMode}}
  {{/each}}

  {{!-- Shared party store: stored on a separate actor, shown in every inventory.
        Its contents never count toward this character's own weight or slots. --}}
  {{#if hasSharedZones}}
  <div class="shared-store-header">
    <h3><i class="fas fa-people-group"></i> {{sharedActorName}}</h3>
    <span class="shared-store-hint">{{localize "DOLMENWOOD.Inv.Shared.Hint"}}</span>
  </div>
  {{#each sharedZones}}
  {{> zone-section zone=this zoneCoins=(lookup ../sharedCoinsByZone this.id) canEdit=../canEdit canGive=false canGiveZone=../sharedIsOwner canShare=../sharedIsOwner isGM=../isGM isOwner=../sharedIsOwner extraZones=../extraZones encMode=../encMode}}
  {{/each}}
  {{/if}}

  {{!-- GM buttons to add zones --}}
  {{#if isGM}}
  <div class="gm-zone-buttons">
    {{#if (neq encMode "weight")}}
    <button type="button" data-action="addExtraZone" class="btn-add-extra-zone">
      <i class="fas fa-plus"></i> {{localize "DOLMENWOOD.Zone.Add.Title"}}
    </button>
    {{/if}}
    <button type="button" data-action="addCustomAnimal" class="btn-add-extra-zone">
      <i class="fas fa-paw"></i> {{localize "DOLMENWOOD.Animal.Title.Add"}}
    </button>
  </div>
  {{/if}}

  {{!-- Party Gear & Wealth summary --}}
  {{> party-summary partySummary=partySummary}}

  {{!-- GM Transaction Log --}}
  {{#if isGM}}
  {{> transaction-log transactions=transactions}}
  {{/if}}
</div>
