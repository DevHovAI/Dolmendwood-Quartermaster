<div class="player-inventory">
  {{!-- Header with actor name. Speed is shown by the encumbrance bar and the
        convoy bar below — a third copy here was the same finalSpeed value. --}}
  <div class="inv-header">
    <h2 class="actor-name">{{actor.name}}</h2>
    {{!-- Only worth showing once something has actually been left behind --}}
    {{#if droppedCount}}
    <button type="button" data-action="toggleDroppedVisibility" class="btn-toolbar btn-dropped-toggle"
            title="{{#if hideDropped}}Show the {{droppedCount}} zone(s) left behind{{else}}Fold away the {{droppedCount}} zone(s) left behind{{/if}}">
      <i class="fas {{#if hideDropped}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
      {{#if hideDropped}}Show{{else}}Hide{{/if}} left behind ({{droppedCount}})
    </button>
    {{/if}}
    {{!-- Opens the shop with this character already selected as the buyer —
          which is why it is worth having here and not only on the toolbar. --}}
    {{#if mayOpenGenericShop}}
    <button type="button" data-action="openShop" class="btn-toolbar btn-shop"
            title="Open the shop, buying for {{actor.name}}">
      <i class="fas fa-store"></i> Shop
    </button>
    {{/if}}
    {{!-- The other half of the character: the sheet's own Inventory button
          comes back here, so the two windows point at each other. --}}
    <button type="button" data-action="openSheet" class="btn-toolbar btn-sheet"
            title="{{actor.name}}'s attributes, saves, skills and traits">
      <i class="fas fa-scroll"></i> Attributes
    </button>
  </div>

  {{!-- Encumbrance bars. The shared store carries nothing itself — a load bar
        against the personal 1,600 wt cap would be meaningless there. --}}
  {{#unless isSharedStore}}
  {{> encumbrance-bar encumbrance=encumbrance encMode=encMode}}
  {{/unless}}

  {{!-- Convoy speed: own marching pace, own animals, and the party-wide slowest.
        "You" is the pace from carried load alone (footSpeed) — the animals get
        their own badges, so using finalSpeed here would just repeat whichever
        animal is slowest. --}}
  <div class="convoy-speed-bar">
    <span class="convoy-label"><i class="fas fa-route"></i> Convoy Speed:</span>
    {{#unless isSharedStore}}
    <span class="own-speed-badge {{speedColor encumbrance.footSpeed}}" title="Your marching pace from what you carry yourself — animals are listed separately">
      <i class="fas fa-person-walking"></i> You: {{speedLabel encumbrance.footSpeed}}
    </span>
    {{/unless}}
    {{#if (eq encMode "weight")}}
    {{#each encumbrance.animalSpeeds}}
    <span class="animal-speed-badge {{#if this.isOverCapacity}}speed-red{{else if this.isOverloaded}}speed-orange{{else if (gte this.effectiveSpeed 40)}}speed-green{{else if (gte this.effectiveSpeed 30)}}speed-yellow{{else}}speed-red{{/if}}"
          title="{{this.zoneName}}: {{this.usedWeight}} / {{this.capacity}} wt{{#if this.isOverCapacity}} — over capacity!{{else if this.isOverloaded}} — overloaded (half speed){{/if}}">
      <i class="fas {{#if this.zoneIcon}}{{this.zoneIcon}}{{else}}fa-horse{{/if}}"></i> {{this.zoneName}}: {{#if this.isOverCapacity}}—{{else}}{{speedLabel this.effectiveSpeed}}{{/if}}
      {{#if this.isOverloaded}}<i class="fas fa-exclamation-triangle"></i>{{/if}}
      {{#if this.isOverCapacity}}<i class="fas fa-times-circle"></i>{{/if}}
    </span>
    {{/each}}
    {{!-- Shared animals pull the party too, so they belong in this bar even
          though they are stored on another actor --}}
    {{#each sharedAnimalSpeeds}}
    <span class="animal-speed-badge is-shared {{#if this.isOverCapacity}}speed-red{{else if this.isOverloaded}}speed-orange{{else if (gte this.effectiveSpeed 40)}}speed-green{{else if (gte this.effectiveSpeed 30)}}speed-yellow{{else}}speed-red{{/if}}"
          title="Shared — {{this.zoneName}}: {{this.usedWeight}} / {{this.capacity}} wt{{#if this.isOverCapacity}} — over capacity!{{else if this.isOverloaded}} — overloaded (half speed){{/if}}">
      <i class="fas fa-people-group"></i>
      <i class="fas {{#if this.zoneIcon}}{{this.zoneIcon}}{{else}}fa-horse{{/if}}"></i> {{this.zoneName}}: {{#if this.isOverCapacity}}—{{else}}{{speedLabel this.effectiveSpeed}}{{/if}}
      {{#if this.isOverloaded}}<i class="fas fa-exclamation-triangle"></i>{{/if}}
      {{#if this.isOverCapacity}}<i class="fas fa-times-circle"></i>{{/if}}
    </span>
    {{/each}}
    {{/if}}
    {{#if partyConvoy}}
    <span class="convoy-final {{#if (gte partyConvoy.speed 40)}}speed-green{{else if (gte partyConvoy.speed 30)}}speed-yellow{{else if (gte partyConvoy.speed 20)}}speed-orange{{else}}speed-red{{/if}}"
          title="Slowest in the party: {{partyConvoy.slowestName}}{{#if (eq partyConvoy.slowestKind "animal")}} ({{partyConvoy.slowestOwner}}){{/if}}">
      <i class="fas fa-users"></i> Party: {{speedLabel partyConvoy.speed}}
      <span class="convoy-slowest">— {{partyConvoy.slowestName}}</span>
    </span>
    {{/if}}
  </div>

  {{!-- Coins — total summary only; per-zone purses appear in each zone section below --}}
  <section class="inv-coins">
    <div class="coins-header">
      <h3><i class="fas fa-coins"></i> Coins</h3>
      {{#if isGM}}
      <button type="button" data-action="grantCoins" class="btn-grant-coins" title="Grant coins to this character">
        <i class="fas fa-gift"></i> Grant Coins
      </button>
      {{/if}}
      {{#if canGive}}
      <button type="button" data-action="giveCoins" class="btn-give-coins" title="Give coins to another party member">
        <i class="fas fa-hand-holding-heart"></i> Give Coins
      </button>
      {{/if}}
    </div>
    {{> coin-display inventory=inventory encumbrance=encumbrance canEdit=canEdit}}
  </section>

  {{!-- Weight mode: Unsorted FIRST (before Equipped), then Equipped --}}
  {{#if (eq encMode "weight")}}
  {{#if showUnsorted}}
  <section class="inv-zone-section inv-zone-unsorted">
    <div class="zone-header">
      <h3><i class="fas fa-exclamation-triangle"></i> Unsorted</h3>
      <span class="zone-count" style="color:orange;">Move to a container</span>
    </div>
    {{> inventory-zone items=zones.stowed zone="stowed" canEdit=canEdit canGive=canGive isGM=isGM isOwner=isOwner canAddItem=false extraZones=extraZones encMode=encMode}}
    {{> zone-coin-purse zoneId="stowed" zoneCoins=(lookup coinsByZone "stowed") canEdit=canEdit isOwner=isOwner}}
  </section>
  {{/if}}
  {{/if}}

  {{!-- Belt Pouch Zone (slot mode only) --}}
  {{#unless (eq encMode "weight")}}
  <section class="inv-zone-section">
    <div class="zone-header">
      <h3><i class="fas fa-gem"></i> Belt Pouch</h3>
      <span class="zone-count {{#if (gt encumbrance.tinyCount 10)}}over-limit{{/if}}">
        {{encumbrance.tinyCount}} / 10
        {{#if (gt encumbrance.tinyOverflow 0)}}
        <span class="overflow-badge" title="{{encumbrance.tinyOverflow}} tiny items overflow into stowed slots">
          +{{encumbrance.tinyOverflow}} overflow
        </span>
        {{/if}}
      </span>
    </div>
    {{> inventory-zone items=zones.tiny zone="tiny" canEdit=canEdit canGive=canGive isGM=isGM isOwner=isOwner canAddItem=canAddItem extraZones=extraZones encMode=encMode}}
    {{> zone-coin-purse zoneId="tiny" zoneCoins=(lookup coinsByZone "tiny") canEdit=canEdit isOwner=isOwner}}
  </section>
  {{/unless}}

  {{!-- Equipped Zone --}}
  <section class="inv-zone-section">
    <div class="zone-header">
      <h3><i class="fas fa-shield-alt"></i> Equipped</h3>
      {{#if (eq encMode "weight")}}
      <span class="zone-count">{{encumbrance.equippedWeight}} wt</span>
      {{else}}
      <span class="zone-count">{{encumbrance.equippedSlots}} slots</span>
      {{/if}}
    </div>
    {{> inventory-zone items=zones.equipped zone="equipped" canEdit=canEdit canGive=canGive isGM=isGM isOwner=isOwner canAddItem=canAddItem extraZones=extraZones encMode=encMode}}
    {{> zone-coin-purse zoneId="equipped" zoneCoins=(lookup coinsByZone "equipped") canEdit=canEdit isOwner=isOwner}}
  </section>

  {{!-- Stowed Zone (slot mode only) --}}
  {{#unless (eq encMode "weight")}}
  <section class="inv-zone-section">
    <div class="zone-header">
      <h3><i class="fas fa-backpack"></i> Stowed</h3>
      <span class="zone-count">{{encumbrance.stowedSlots}} slots
        {{#if (gt encumbrance.coinSlots 0)}}
        <span class="coin-slot-note" title="Includes {{encumbrance.coinSlots}} slot(s) from coins">
          ({{encumbrance.coinSlots}} coins)
        </span>
        {{/if}}
      </span>
    </div>
    {{> inventory-zone items=zones.stowed zone="stowed" canEdit=canEdit canGive=canGive isGM=isGM isOwner=isOwner canAddItem=canAddItem extraZones=extraZones encMode=encMode}}
    {{> zone-coin-purse zoneId="stowed" zoneCoins=(lookup coinsByZone "stowed") canEdit=canEdit isOwner=isOwner}}
  </section>
  {{/unless}}

  {{!-- Storage Zones (weight mode: backpack, sack, etc.) --}}
  {{#if (eq encMode "weight")}}
  {{#each storageZones}}
  {{> zone-section zone=this zoneCoins=(lookup ../coinsByZone this.id) canEdit=../canEdit canGive=../canGive canGiveZone=../canGiveZone canShare=../canShare isGM=../isGM isOwner=../isOwner extraZones=../extraZones encMode=../encMode}}
  {{/each}}
  {{/if}}

  {{!-- Vehicle/Animal Zones --}}
  {{#each vehicleZones}}
  {{> zone-section zone=this zoneCoins=(lookup ../coinsByZone this.id) canEdit=../canEdit canGive=../canGive canGiveZone=../canGiveZone canShare=../canShare isGM=../isGM isOwner=../isOwner extraZones=../extraZones encMode=../encMode}}
  {{/each}}

  {{!-- Shared party store: stored on a separate actor, shown in every inventory.
        Its contents never count toward this character's own weight or slots. --}}
  {{#if hasSharedZones}}
  <div class="shared-store-header">
    <h3><i class="fas fa-people-group"></i> {{sharedActorName}}</h3>
    <span class="shared-store-hint">Shared with the whole party — does not count toward your load</span>
  </div>
  {{#each sharedZones}}
  {{> zone-section zone=this zoneCoins=(lookup ../sharedCoinsByZone this.id) canEdit=../canEdit canGive=false canGiveZone=../sharedIsOwner canShare=../sharedIsOwner isGM=../isGM isOwner=../sharedIsOwner extraZones=../extraZones encMode=../encMode}}
  {{/each}}
  {{/if}}

  {{!-- GM buttons to add zones --}}
  {{#if isGM}}
  <div class="gm-zone-buttons">
    {{#if (neq encMode "weight")}}
    <button type="button" data-action="addExtraZone" class="btn-add-extra-zone">
      <i class="fas fa-plus"></i> Add Storage Zone
    </button>
    {{/if}}
    <button type="button" data-action="addCustomAnimal" class="btn-add-extra-zone">
      <i class="fas fa-paw"></i> Add Custom Animal / Vehicle
    </button>
  </div>
  {{/if}}

  {{!-- Party Gear & Wealth summary --}}
  {{> party-summary partySummary=partySummary}}

  {{!-- GM Transaction Log --}}
  {{#if isGM}}
  {{> transaction-log transactions=transactions}}
  {{/if}}
</div>
