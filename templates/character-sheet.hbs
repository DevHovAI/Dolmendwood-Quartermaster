{{!-- Page one of the printed Dolmenwood sheet, laid out for a window rather
      than for paper (Dolmenmaster, 2026-08-28):

        who they are  ·  who they are when not rolling dice (folded)
        the six scores
        the five saves
        what they hold  |  what keeps them standing
        everything the table wrote
        what they are good at  |  what they have earned

      **Every box is on a shared grid.** The fields were sized by their contents
      at first, which is right for a printed sheet and wrong for a form: the
      column went crooked the moment somebody rolled an 18 or earned a fifth
      digit of experience. One field class, one height, one lane per column. --}}

<div class="dw-sheet-body">

  {{#unless hasSystem}}
  <p class="dw-sheet-warning">
    <i class="fas fa-triangle-exclamation"></i>
    {{localize "DOLMENWOOD.Sheet.NoSystem"}}
  </p>
  {{/unless}}

  {{!-- ── Who they are ─────────────────────────────────────────────────── --}}
  <header class="dw-sheet-head">
    {{!-- A portrait, not a token. It is the one thing on the page that says who
          this is rather than what they can do.

          **The box cannot make a small file bigger.** It is drawn at 200px on a
          screen that is often twice that in real pixels, so a 128px token
          picture arrives soft however the stylesheet is written. Two answers,
          both here: click it to see the file at its own size, and the button
          picks a better one. `_onRender` measures what actually loaded and says
          so in the tooltip, rather than leaving it a mystery. --}}
    <div class="dw-sheet-portrait-box">
      {{#if img}}
      <img class="dw-sheet-portrait" src="{{img}}" alt="" data-action="showPortrait"
           title="{{localize "DOLMENWOOD.Sheet.Portrait.Show"}}">
      {{/if}}
      {{#if canEdit}}
      <button type="button" class="dw-portrait-edit" data-action="pickPortrait"
              title="{{localize "DOLMENWOOD.Sheet.Portrait.Pick"}}">
        <i class="fas fa-image"></i>
      </button>
      {{/if}}
    </div>

    <div class="dw-sheet-identity">
      <div class="dw-sheet-titlebar">
        <h2 class="dw-sheet-name">{{name}}</h2>
        <div class="dw-sheet-head-actions">
          {{!-- Applies to everything on the page, so it belongs where the page
                is titled and not in a stripe between two sections it does not
                favour. Never stored: a stored one is eventually a forgotten
                one. --}}
          <label class="dw-sheet-situational" title="{{localize "DOLMENWOOD.Sheet.Situational.Hint"}}">
            <span>{{localize "DOLMENWOOD.Sheet.Situational.Label"}}</span>
            <input type="number" id="dw-sheet-situational" value="0" step="1">
          </label>
          <button type="button" class="dw-sheet-btn" data-action="openInventory"
                  title="{{localize "DOLMENWOOD.Sheet.Inventory.Hint"}}">
            <i class="fas fa-backpack"></i> {{localize "DOLMENWOOD.Sheet.Inventory.Label"}}
          </button>
        </div>
      </div>

      <div class="dw-fields dw-fields-3">
        <label class="dw-field">
          <span>{{localize "DOLMENWOOD.Sheet.Field.Kindred"}}</span>
          {{!-- A list, not a dropdown, for the reason the Class field gives
                below: the six are offered without being imposed. --}}
          <input type="text" data-extra="kindred" value="{{identity.kindred}}" list="dw-kindred-list"
                 {{#unless canEdit}}disabled{{/unless}}>
          <datalist id="dw-kindred-list">
            {{#each kindredNames}}<option value="{{this}}"></option>{{/each}}
          </datalist>
        </label>
        <label class="dw-field">
          <span>{{localize "DOLMENWOOD.Sheet.Field.Class"}}</span>
          {{!-- A list, not a dropdown: OSE keeps this as free text and a table
                may write "Fighter 3" or a Class this module has never heard of,
                so the nine are offered without being imposed. Naming one of
                them is what unlocks the XP modifier and the level-up buttons
                below. --}}
          <input type="text" data-field="class" value="{{identity.class}}" list="dw-class-list"
                 {{#unless canEdit}}disabled{{/unless}}>
          <datalist id="dw-class-list">
            {{#each classNames}}<option value="{{this}}"></option>{{/each}}
          </datalist>
        </label>
        <label class="dw-field">
          <span>{{localize "DOLMENWOOD.Sheet.Field.Alignment"}}</span>
          <input type="text" data-field="alignment" value="{{identity.alignment}}" list="dw-alignment-list"
                 {{#unless canEdit}}disabled{{/unless}}>
          <datalist id="dw-alignment-list">
            {{#each alignmentNames}}<option value="{{this}}"></option>{{/each}}
          </datalist>
        </label>
        <label class="dw-field">
          <span>{{localize "DOLMENWOOD.Sheet.Field.Background"}}</span>
          {{!-- **The suggestions are the Kindred's own d20 table**, because the
                book prints one per Kindred rather than one for everybody. Fill
                the Kindred in first and this fills itself with onion farmers or
                unicorn handlers as the case may be; a Kindred the book never
                printed offers nothing rather than somebody else's trades. --}}
          <input type="text" data-extra="background" value="{{identity.background}}"
                 {{#if backgroundOptions}}list="dw-background-list"{{/if}}
                 {{#unless canEdit}}disabled{{/unless}}>
          {{#if backgroundOptions}}
          <datalist id="dw-background-list">
            {{#each backgroundOptions}}<option value="{{this}}"></option>{{/each}}
          </datalist>
          {{/if}}
        </label>
        <label class="dw-field">
          <span>{{localize "DOLMENWOOD.Sheet.Field.Affiliation"}}</span>
          <input type="text" data-extra="affiliation" value="{{identity.affiliation}}" {{#unless canEdit}}disabled{{/unless}}>
        </label>
        {{!-- Languages sit up here with the other one-word facts. OSE keeps them
              as an array; the sheet asks for one line and splits on commas.
              **No example in the box** — Dolmenmaster, 2026-08-28: a greyed-out
              "Woldish, Sylvan" reads as though it were already filled in. --}}
        {{!-- **The picker lives in the field's own cell**, under the box rather
              than under the row (Dolmenmaster, 2026-09-03): a panel that writes into
              one field belongs against that field, and a full-width strip below
              three columns reads as though it belonged to all of them.
              The <label> is nested so that clicking the word still focuses the
              box; a <summary> inside a <label> would focus it too, which is
              precisely what the nesting keeps apart. --}}
        <div class="dw-field dw-field-langs">
          <label class="dw-field">
            <span>{{localize "DOLMENWOOD.Sheet.Field.Languages"}}</span>
            <input type="text" data-field="languages" value="{{languages}}"
                   title="{{localize "DOLMENWOOD.Sheet.Field.LanguagesHint"}}"
                   {{#unless canEdit}}disabled{{/unless}}>
          </label>
          {{!-- **Ticked rather than listed** (Dolmenmaster, 2026-09-03). A datalist
                is no use here: the field holds a comma-separated line, and a
                browser matches its suggestions against the whole box, so it
                would help with the first language and never again. So the
                book's own tongues are ticked and the line is written from the
                ticks — while anything typed by hand stays exactly where it was
                typed, which is what keeps the field the authority and the panel
                only a convenience. --}}
          {{#if canEdit}}
          <details class="dw-lang-picker" {{#if langPickerOpen}}open{{/if}}>
            <summary><i class="fas fa-chevron-right dw-lang-caret"></i>{{localize "DOLMENWOOD.Sheet.Pick.FromBook"}}</summary>
            <div class="dw-lang-groups">
              {{#each languageGroups}}
              <div class="dw-lang-group">
                <span class="dw-lang-group-label">{{this.label}}</span>
                {{#each this.languages}}
                <label class="dw-lang-pick">
                  <input type="checkbox" class="dw-lang-box" value="{{this}}">
                  <span>{{this}}</span>
                </label>
                {{/each}}
              </div>
              {{/each}}
            </div>
          </details>
          {{/if}}
        </div>
      </div>

      {{!-- **The moon sign gets the whole line and room to breathe.** It is not
            a label but a rule: each sign carries effects the table has to be
            able to write down and read back, and a one-word box would have made
            it a name with the mechanics kept somewhere else. --}}
      <div class="dw-field dw-field-wide dw-field-moon">
        <label class="dw-field">
          <span>{{localize "DOLMENWOOD.Sheet.Field.MoonSign"}}</span>
          <textarea data-extra="moonSign" rows="2"
                    placeholder="{{localize "DOLMENWOOD.Sheet.Field.MoonSignPlaceholder"}}"
                    {{#unless canEdit}}disabled{{/unless}}>{{identity.moonSign}}</textarea>
        </label>
        {{!-- **Picked, not typed, and the effect goes where rules go.** A sign
              is permanent (p175) and gets read mid-fight, so choosing one both
              writes this field and files a block of its own beside the Kindred
              traits — see `_onPickMoonSign`. The panel floats for the same
              reason the languages one does: the portrait is drawn square from
              this block's height, and a panel that opened in the flow made the
              picture swallow the window. --}}
        {{#if canEdit}}
        <details class="dw-moon-picker" {{#if moonPickerOpen}}open{{/if}}>
          <summary><i class="fas fa-chevron-right dw-lang-caret"></i>{{localize "DOLMENWOOD.Sheet.Pick.Moon36"}}</summary>
          <div class="dw-moon-panel">
            {{#if moonSignForeign}}
            <p class="hint dw-moon-note">{{localize "DOLMENWOOD.Sheet.Moon.Foreign"}}</p>
            {{/if}}
            <div class="dw-moon-months">
              {{#each moonSigns}}
              <div class="dw-moon-group">
                <span class="dw-moon-name">{{localize "DOLMENWOOD.Sheet.Moon.Of" moon=this.moon}}</span>
                {{#each this.signs}}
                <button type="button" class="dw-moon-sign {{#if this.chosen}}is-chosen{{/if}}"
                        data-action="pickMoonSign" data-moon-index="{{this.index}}"
                        title="{{localize "DOLMENWOOD.Sheet.Moon.Take" range=this.range}}">
                  <span class="dw-moon-phase">{{this.phase}}</span>
                  <span class="dw-moon-effect">{{this.effect}}</span>
                </button>
                {{/each}}
              </div>
              {{/each}}
            </div>
          </div>
        </details>
        {{/if}}
      </div>
    </div>
  </header>

  {{!-- ── Who this person is when they are not rolling dice ────────────── --}}
  {{!-- A <details>, and no script behind it. It sits with the other things that
        say who this is — up by the portrait and the kindred — and **starts
        folded whether or not there is anything in it** (Dolmenmaster, 2026-08-28).
        It used to open itself when filled, which was right at the foot of the
        page and wrong above the scores: it would push every number down the
        window on exactly the sheets that had most written on them. --}}
  {{!-- **It starts folded and stays as it was put.** Folded on a fresh window
        is Dolmenmaster's ruling above; what it must not do is fold itself while
        somebody is working in it. Picking a suggestion writes the actor, that
        re-draws the whole sheet, and a <details> with no `open` on it comes
        back shut — which read as "man kann die eingaben nicht wieder ändern"
        (Dolmenmaster, 2026-09-03). Same fix as the two pickers: the state rides on
        the window. --}}
  <details class="dw-sheet-section dw-sheet-persona" {{#if personaOpen}}open{{/if}}>
    <summary><i class="fas fa-chevron-right dw-sheet-persona-caret"></i>{{localize "DOLMENWOOD.Sheet.Persona.Title"}}</summary>
    <div class="dw-fields dw-fields-3">
      {{!-- Each box offers its Kindred's own d12 table. The two wide ones hold a
            sentence and are therefore textareas, and no browser puts a datalist
            on one of those — so Desires and Beliefs keep their tables in the
            book and their boxes empty. --}}
      {{#each persona}}
      {{#if this.wide}}
      {{!-- Desires and Beliefs hold a sentence, so they are textareas — and a
            textarea takes no datalist. Their d12 goes under the box as a panel
            instead: same table, offered the other way round. --}}
      <div class="dw-field dw-field-span dw-field-persona">
        <label class="dw-field">
          <span>{{this.label}}</span>
          <textarea data-extra="persona-{{this.key}}" rows="2" {{#unless ../canEdit}}disabled{{/unless}}>{{this.value}}</textarea>
        </label>
        {{#if this.picks}}{{#if ../canEdit}}
        <details class="dw-persona-picker" data-persona-key="{{this.key}}" {{#if this.pickerOpen}}open{{/if}}>
          <summary><i class="fas fa-chevron-right dw-lang-caret"></i>{{localize "DOLMENWOOD.Sheet.Pick.FromBook"}}</summary>
          <div class="dw-persona-panel">
            {{#each this.picks}}
            <button type="button" class="dw-persona-pick {{#if this.chosen}}is-chosen{{/if}}"
                    data-action="pickPersona" data-persona-key="{{../key}}"
                    data-persona-value="{{this.text}}"
                    title="{{localize "DOLMENWOOD.Sheet.Persona.Take"}}">{{this.text}}</button>
            {{/each}}
          </div>
        </details>
        {{/if}}{{/if}}
      </div>
      {{else}}
      <label class="dw-field">
        <span>{{this.label}}</span>
        <input type="text" data-extra="persona-{{this.key}}" value="{{this.value}}"
               {{#if this.options}}list="dw-persona-{{this.key}}-list"{{/if}}
               {{#unless ../canEdit}}disabled{{/unless}}>
        {{#if this.options}}
        <datalist id="dw-persona-{{this.key}}-list">
          {{#each this.options}}<option value="{{this}}"></option>{{/each}}
        </datalist>
        {{/if}}
      </label>
      {{/if}}
      {{/each}}
    </div>
  </details>

  {{!-- ── The six ──────────────────────────────────────────────────────── --}}
  <section class="dw-sheet-section">
    <h3>{{localize "DOLMENWOOD.Sheet.Abilities.Title"}}</h3>
    <div class="dw-sheet-abilities">
      {{#each abilities}}
      <div class="dw-ability">
        <span class="dw-ability-label">{{this.label}}</span>
        <div class="dw-ability-numbers">
          <label class="dw-ability-score" title="{{localize "DOLMENWOOD.Sheet.Abilities.Score"}}">
            <input type="number" data-field="score-{{this.key}}" value="{{this.value}}" {{#unless ../canEdit}}disabled{{/unless}}>
          </label>
          <label class="dw-ability-mod {{#if this.houseRuled}}is-house-ruled{{/if}}"
                 title="{{#if this.houseRuled}}{{localize "DOLMENWOOD.Sheet.Abilities.ModHouseRuled" book=this.byTheBook score=this.value}}{{else}}{{localize "DOLMENWOOD.Sheet.Abilities.Mod"}}{{/if}}">
            <input type="number" data-field="mod-{{this.key}}" value="{{this.bonus}}" {{#unless ../canEdit}}disabled{{/unless}}>
          </label>
        </div>
        <button type="button" class="dw-roll-btn" data-action="rollAbility" data-ability="{{this.key}}"
                title="{{localize "DOLMENWOOD.Sheet.Abilities.CheckHint" mod=this.signed target=../abilityCheckTarget}}">
          <i class="fas fa-dice-d6"></i> {{localize "DOLMENWOOD.Sheet.Abilities.Check"}}
        </button>
        <span class="dw-ability-governs">{{this.governs}}</span>
      </div>
      {{/each}}
    </div>
  </section>

  {{!-- ── The five ─────────────────────────────────────────────────────── --}}
  {{!-- A row of its own under the scores (Dolmenmaster, 2026-08-28), which is what
        gives the weapons and the fighting numbers their width back. **Across
        rather than down**: five stacked rows in a full-width section would be a
        tall stripe of empty paper, and the saves read like the scores above
        them because they are the same kind of thing — a number you roll
        against. --}}
  <section class="dw-sheet-section">
    <h3>
      {{localize "DOLMENWOOD.Sheet.Saves.Title"}}
      {{!-- It belongs here and nowhere else: `magical` exists on exactly one of
            the six roll kinds, and adding Wisdom to an Ability Check or an
            attack is not a thing the book ever does. --}}
      <label class="dw-sheet-magic" title="{{localize "DOLMENWOOD.Sheet.Saves.MagicHint"}}">
        <input type="checkbox" id="dw-sheet-magical">
        <span>{{{localize "DOLMENWOOD.Sheet.Saves.Magic"}}}</span>
      </label>
    </h3>
    <div class="dw-sheet-saves">
      {{#each saves}}
      <div class="dw-save">
        <span class="dw-save-label">{{this.label}}</span>
        <input type="number" class="is-number" data-field="save-{{this.key}}" value="{{this.value}}" {{#unless ../canEdit}}disabled{{/unless}}>
        <button type="button" class="dw-roll-btn" data-action="rollSave" data-save="{{this.key}}"
                title="{{localize "DOLMENWOOD.Sheet.Saves.RollHint" target=this.value}}">
          <i class="fas fa-dice-d20"></i> {{localize "DOLMENWOOD.Sheet.Saves.Roll"}}
        </button>
      </div>
      {{/each}}
    </div>
  </section>

  {{!-- ── The fighting pair ────────────────────────────────────────────── --}}
  {{!-- Half the window each, and one height between them. --}}
  <div class="dw-sheet-columns is-pair">

    <section class="dw-sheet-section">
      <h3>{{localize "DOLMENWOOD.Sheet.Weapons.Title"}}</h3>
      {{!-- Only when it costs something. A fed and rested character gets no line,
            because "no penalty" is not news. --}}
      {{#if penalties}}
      <p class="dw-sheet-penalty"><i class="fas fa-face-tired"></i> {{penalties}}</p>
      {{/if}}
      {{#if hasWeapons}}
      <div class="dw-weapon-list">
        {{#each weapons}}
        <div class="dw-weapon-row">
          <span class="dw-weapon-name">
            <i class="fas {{#if this.icon}}{{this.icon}}{{else}}fa-gavel{{/if}}"></i>
            {{this.name}}
            <span class="dw-weapon-damage">{{this.damage}}</span>
          </span>
          {{#if this.bands}}
          <select class="dw-weapon-band" data-item-id="{{this.itemId}}" title="{{localize "DOLMENWOOD.Sheet.Weapons.BandHint"}}">
            {{#each this.bands}}
            <option value="{{this.key}}"{{#if (eq this.key "medium")}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
          {{/if}}
          <span class="dw-weapon-buttons">
            {{#each this.modes}}
            <button type="button" class="dw-roll-btn" data-action="rollAttack"
                    data-item-id="{{../this.itemId}}" data-missile="{{this.missile}}"
                    title="{{localize "DOLMENWOOD.Sheet.Weapons.AttackHint" mode=this.label}}">
              <i class="fas fa-crosshairs"></i> {{this.label}}
            </button>
            {{/each}}
            {{#each this.modes}}
            <button type="button" class="dw-roll-btn is-damage" data-action="rollDamage"
                    data-item-id="{{../this.itemId}}" data-missile="{{this.missile}}"
                    title="{{#if this.missile}}{{localize "DOLMENWOOD.Sheet.Weapons.DamageHint" mode=this.label}}{{else}}{{localize "DOLMENWOOD.Sheet.Weapons.DamageHintMelee" mode=this.label}}{{/if}}">
              <i class="fas fa-burst"></i> {{localize "DOLMENWOOD.Sheet.Weapons.Damage" mode=this.label}}
            </button>
            {{/each}}
          </span>
          {{#if this.notesLine}}<span class="dw-weapon-notes" title="{{localize "DOLMENWOOD.Sheet.Weapons.NotesHint"}}">{{this.notesLine}}</span>{{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="dw-sheet-hint">{{{localize "DOLMENWOOD.Sheet.Weapons.None"}}}</p>
      {{/if}}
    </section>

    <section class="dw-sheet-section">
      <h3>{{localize "DOLMENWOOD.Sheet.Fight.Title"}}</h3>
      <div class="dw-fields dw-fields-2">
        <label class="dw-field">
          <span>{{localize "DOLMENWOOD.Sheet.Fight.Hp"}}</span>
          <input type="number" class="is-number" data-field="hp" value="{{hp.value}}" {{#unless canEdit}}disabled{{/unless}}>
        </label>
        <label class="dw-field">
          <span>{{localize "DOLMENWOOD.Sheet.Fight.HpMax"}}</span>
          <input type="number" class="is-number" data-field="hpMax" value="{{hp.max}}" {{#unless canEdit}}disabled{{/unless}}>
        </label>
        {{!-- AC is the one number OSE derives from the armour worn, so an edit
              here becomes a change to the modifier rather than the total. --}}
        <label class="dw-field" title="{{localize "DOLMENWOOD.Sheet.Fight.AcHint"}}">
          <span>{{localize "DOLMENWOOD.Sheet.Fight.Ac"}}</span>
          <input type="number" class="is-number" data-field="ac" value="{{ac}}" {{#unless canEdit}}disabled{{/unless}}>
        </label>
        <label class="dw-field">
          <span>{{localize "DOLMENWOOD.Sheet.Fight.Attack"}}</span>
          <input type="number" class="is-number" data-field="attack" value="{{attack}}" {{#unless canEdit}}disabled{{/unless}}>
        </label>
        <label class="dw-field dw-field-span" title="{{localize "DOLMENWOOD.Sheet.Fight.MagicResistanceHint" derived=magicResistanceDerived}}">
          <span>{{localize "DOLMENWOOD.Sheet.Fight.MagicResistance"}}</span>
          <input type="text" data-extra="magicResistance" value="{{magicResistance}}"
                 placeholder="{{magicResistanceDerived}}" {{#unless canEdit}}disabled{{/unless}}>
        </label>
      </div>
    </section>

  </div>

  {{!-- ── Everything the table wrote ───────────────────────────────────── --}}
  {{!-- The whole width, because it is the one part of this sheet that grows
        without limit: a Knight has four traits and a Friar at ninth level has
        two dozen blocks. --}}
  <section class="dw-sheet-section dw-sheet-blocks">
    <h3>
      <span class="dw-sheet-heading-text">{{localize "DOLMENWOOD.Sheet.Blocks.Title"}}</span>
      {{!-- The spell count lives with the spells. Nought means "not a
            spell-caster", which is why one number carries both answers and why
            the morning's duty need not be told twice. --}}
      <label class="dw-sheet-prepares" title="{{localize "DOLMENWOOD.Sheet.Blocks.PreparesHint"}}">
        <span>{{localize "DOLMENWOOD.Sheet.Blocks.Prepares"}}</span>
        <input type="number" class="is-number" data-extra="prepares" min="0" max="20" value="{{prepares}}" {{#unless canEdit}}disabled{{/unless}}>
      </label>
      {{!-- What this morning's preparation left to spend. Only shown to a sheet
            that has spells on it at all — a fighter has no use for the line. --}}
      {{#if hasSpells}}
      <span class="dw-sheet-credits {{#unless spellCredits}}is-spent{{/unless}}"
            title="{{localize "DOLMENWOOD.Sheet.Blocks.CreditsHint"}}">
        <i class="fas fa-wand-sparkles"></i> {{spellCreditLine}}
      </span>
      {{/if}}
      {{#if canEdit}}
      <button type="button" class="dw-sheet-add" data-action="addBlock" title="{{localize "DOLMENWOOD.Sheet.Blocks.AddHint"}}">
        <i class="fas fa-plus"></i> {{localize "DOLMENWOOD.Common.Add"}}
      </button>
      {{/if}}
    </h3>

    {{#if hasBlocks}}
    {{#each groups}}
    <div class="dw-block-group">
      <h4>{{this.label}}</h4>
      {{#each this.blocks}}
      <div class="dw-block {{#if this.prepared}}is-prepared{{/if}}">
        <div class="dw-block-head">
          {{#if this.uses}}
          <span class="dw-block-uses" title="{{localize "DOLMENWOOD.Sheet.Blocks.UsesHint"}}">
            {{#if ../../canEdit}}
            <button type="button" class="dw-uses-btn" data-action="spendUse" data-block-id="{{this.id}}"
                    title="{{localize "DOLMENWOOD.Sheet.Blocks.UseOne"}}">&minus;</button>
            {{/if}}
            <span>{{this.uses.value}}/{{this.uses.max}}</span>
            {{#if ../../canEdit}}
            <button type="button" class="dw-uses-btn" data-action="restoreUses" data-block-id="{{this.id}}"
                    title="{{localize "DOLMENWOOD.Sheet.Blocks.Restore"}}">
              <i class="fas fa-rotate-left"></i>
            </button>
            {{/if}}
          </span>
          {{/if}}
          <span class="dw-block-name">{{this.name}}</span>
          {{#if this.spell}}
          <span class="dw-block-spell is-{{this.spell}}"
                title="{{#if this.isArcane}}{{localize "DOLMENWOOD.Sheet.Blocks.ArcaneHint"}}{{else}}{{localize "DOLMENWOOD.Sheet.Blocks.HolyHint"}}{{/if}}">
            {{#if this.isArcane}}<i class="fas fa-hat-wizard"></i> {{localize "DOLMENWOOD.Sheet.Blocks.Arcane"}}{{else}}<i class="fas fa-hands-praying"></i> {{localize "DOLMENWOOD.Sheet.Blocks.Holy"}}{{/if}}
          </span>
          {{/if}}
          {{#if this.value}}<span class="dw-block-value" title="{{localize "DOLMENWOOD.Sheet.Blocks.ValueHint" slug=this.slug}}">{{this.value}}</span>{{/if}}
          <code class="dw-block-address" title="{{localize "DOLMENWOOD.Sheet.Blocks.AddressHint"}}">@b.{{this.slug}}</code>
          {{!-- Every control here keeps its column whether or not this block has
                it, so Roll is in one place down the whole list. Without the two
                slots below, a spell's book button widened a right-aligned group
                and shoved Roll leftwards on exactly the rows that had one
                (Dolmenmaster, 2026-08-31). --}}
          <span class="dw-block-actions">
            {{#if this.rollable}}
            <button type="button" class="dw-roll-btn" data-action="rollBlock" data-block-id="{{this.id}}"
                    title="{{localize "DOLMENWOOD.Sheet.Blocks.RollHint"}}">
              <i class="fas fa-dice-d20"></i> {{localize "DOLMENWOOD.Common.Roll"}}
            </button>
            {{else}}
            <span class="roll-slot"></span>
            {{/if}}
            {{#if ../../canEdit}}
            {{!-- Only a spell. Ticking a Kindred trait as "prepared for today"
                  is a control with nothing behind it.

                  A pair of controls rather than one tick, because a spell may
                  be prepared more than once: one credit buys one charge, and
                  taking a charge back hands the credit over again. Casting is
                  what spends a charge for good, and that is the Roll button. --}}
            {{#if this.spell}}
            <span class="dw-spell-charges">
              {{#if this.charges}}
              <button type="button" class="dw-uses-btn" data-action="togglePrepared"
                      data-block-id="{{this.id}}" data-unmark="true"
                      title="{{localize "DOLMENWOOD.Sheet.Blocks.Unmark" name=this.name}}">&minus;</button>
              {{/if}}
              <button type="button" class="icon-btn{{#unless this.canMark}} is-spent{{/unless}}"
                      data-action="togglePrepared" data-block-id="{{this.id}}"
                      {{#unless this.canMark}}disabled{{/unless}}
                      title="{{#if this.isArcane}}{{localize "DOLMENWOOD.Sheet.Blocks.MarkArcane"}}{{else}}{{localize "DOLMENWOOD.Sheet.Blocks.MarkHoly"}}{{/if}}">
                <i class="fas {{#if this.charges}}fa-book-bookmark{{else}}fa-book{{/if}}"></i>
              </button>
              {{#if this.charges}}<span class="dw-spell-charge-count" title="{{localize "DOLMENWOOD.Sheet.Blocks.ChargesHint" charges=this.chargeLabel}}">{{this.charges}}</span>{{/if}}
            </span>
            {{else}}
            <span class="icon-slot"></span>
            {{/if}}
            <button type="button" class="icon-btn" data-action="editBlock" data-block-id="{{this.id}}" title="{{localize "DOLMENWOOD.Sheet.Blocks.Edit"}}">
              <i class="fas fa-pen"></i>
            </button>
            <button type="button" class="icon-btn delete-btn" data-action="deleteBlock" data-block-id="{{this.id}}" title="{{localize "DOLMENWOOD.Sheet.Blocks.Delete"}}">
              <i class="fas fa-trash"></i>
            </button>
            {{/if}}
          </span>
        </div>
        {{#if this.text}}<p class="dw-block-text">{{this.text}}</p>{{/if}}
      </div>
      {{/each}}
    </div>
    {{/each}}
    {{else}}
    <p class="dw-sheet-hint">{{{localize "DOLMENWOOD.Sheet.Blocks.None"}}}</p>
    {{/if}}
  </section>

  {{!-- ── The foot: what they are good at, and what they have earned ───── --}}
  <div class="dw-sheet-columns is-foot">

    <section class="dw-sheet-section">
      <h3>{{localize "DOLMENWOOD.Sheet.Skills.Title"}}</h3>
      <p class="dw-sheet-hint">{{localize "DOLMENWOOD.Sheet.Skills.Hint"}}</p>
      {{!-- **Two columns of three** (Dolmenmaster, 2026-08-28): the book's three on
            the left, the table's own on the right, and **an empty lane is the
            button that fills it** — no Add in the heading, because the place
            the new row will appear is a better door than a button somewhere
            else. Nobody plays a character with more than six, so the section
            has a height that never moves, which is what lets it and Experience
            be pinned to each other. A sheet that somehow carries more keeps
            them all: the grid grows a row rather than hiding one. --}}
      <div class="dw-skill-grid">
        {{#each skills}}
        {{#if this.empty}}
        {{#if this.add}}{{#if ../canEdit}}
        <button type="button" class="dw-skill-empty" data-action="addSkill"
                title="{{localize "DOLMENWOOD.Sheet.Skills.AddHint"}}">
          <i class="fas fa-plus"></i> {{localize "DOLMENWOOD.Common.Add"}}
        </button>
        {{else}}<span class="dw-skill-blank"></span>{{/if}}
        {{else}}<span class="dw-skill-blank"></span>{{/if}}
        {{else}}
        <div class="dw-row">
          <span class="dw-row-label" title="{{localize "DOLMENWOOD.Sheet.Skills.AddressHint" address=this.address}}">{{this.label}}</span>
          <input type="number" class="is-number" data-extra="skill-{{this.key}}" min="1" max="6" value="{{this.target}}" {{#unless ../canEdit}}disabled{{/unless}}>
          <button type="button" class="dw-roll-btn is-icon" data-action="rollSkill" data-skill="{{this.key}}"
                  title="{{localize "DOLMENWOOD.Sheet.Skills.RollHint" target=this.target}}">
            <i class="fas fa-dice-d6"></i>
          </button>
          {{!-- A lane that stays whether or not there is a bin in it, so the
                book's rows and the table's own still line up. --}}
          <span class="dw-row-trail">
            {{#if this.custom}}{{#if ../canEdit}}
            <button type="button" class="icon-btn delete-btn" data-action="deleteSkill" data-skill-id="{{this.key}}"
                    title="{{localize "DOLMENWOOD.Sheet.Skills.DeleteHint"}}">
              <i class="fas fa-trash"></i>
            </button>
            {{/if}}{{/if}}
          </span>
        </div>
        {{/if}}
        {{/each}}
      </div>
    </section>

    <section class="dw-sheet-section">
      <h3>{{localize "DOLMENWOOD.Sheet.Experience.Title"}}</h3>
      <div class="dw-fields dw-fields-2">
        {{!-- Level lives here, not among the fighting numbers: it is what
              experience buys, and the box beside it is the one that says how
              much more is needed (Dolmenmaster, 2026-08-27). --}}
        <label class="dw-field">
          <span>{{localize "DOLMENWOOD.Sheet.Experience.Level"}}</span>
          <input type="number" class="is-number" data-field="level" value="{{level}}" {{#unless canEdit}}disabled{{/unless}}>
        </label>
        {{!-- Worked out from the Class's Prime Abilities and still typeable:
              typing marks it hand-set, and the arrow hands it back. --}}
        <label class="dw-field" title="{{#if xpMod.hasDerived}}{{#if xpMod.manual}}{{localize "DOLMENWOOD.Sheet.XpMod.Manual" derived=xpMod.derived}}{{else}}{{localize "DOLMENWOOD.Sheet.XpMod.Derived"}}{{/if}}{{else}}{{localize "DOLMENWOOD.Sheet.XpMod.Plain"}}{{/if}}">
          <span>{{localize "DOLMENWOOD.Sheet.XpMod.Label"}}{{#if xpMod.manual}} <em class="dw-sheet-handset">{{localize "DOLMENWOOD.Sheet.XpMod.HandSet"}}</em>{{/if}}</span>
          <span class="dw-field-with-reset">
            <input type="number" class="is-number" data-field="xpBonus" value="{{xpMod.value}}" {{#unless canEdit}}disabled{{/unless}}>
            {{#if xpMod.canReset}}
            <button type="button" class="icon-btn" data-action="resetXpMod" {{#unless canEdit}}disabled{{/unless}}
                    title="{{localize "DOLMENWOOD.Sheet.XpMod.Reset" derived=xpMod.derived}}">
              <i class="fas fa-rotate-left"></i>
            </button>
            {{/if}}
          </span>
        </label>
        {{!-- Wide, because these hold five and six digits, and a box that cuts
              a number in half is worse than no box at all. --}}
        <label class="dw-field dw-field-span">
          <span>{{localize "DOLMENWOOD.Sheet.Experience.Xp"}}</span>
          <input type="number" class="is-wide" data-field="xp" value="{{xp.value}}" {{#unless canEdit}}disabled{{/unless}}>
        </label>

        {{#if advance}}
        {{!-- Read out of the Class's advancement table rather than typed: both
              are printed facts about a Class and a Level (Dolmenmaster, 2026-09-02).
              Italic, which in this module means "this was not typed here". --}}
        <div class="dw-field dw-field-derived" title="{{localize "DOLMENWOOD.Sheet.Advance.NextHint" class=advance.classLabel}}">
          <span>{{localize "DOLMENWOOD.Sheet.Advance.Next"}}</span>
          <span class="dw-derived-value">{{#if advance.hasNext}}{{advance.nextXp}}{{else}}&mdash;{{/if}}</span>
        </div>
        <div class="dw-field dw-field-derived {{#if advance.atCap}}is-at-cap{{/if}}" title="{{localize "DOLMENWOOD.Sheet.Advance.CapHint"}}">
          <span>{{localize "DOLMENWOOD.Sheet.Advance.Cap"}}</span>
          <span class="dw-derived-value">
            {{#if advance.hasCap}}{{advance.capXp}}{{#unless advance.atCap}} <em>{{localize "DOLMENWOOD.Sheet.Advance.ToGo" n=advance.toCap}}</em>{{/unless}}{{else}}&mdash;{{/if}}
          </span>
        </div>
        {{else}}
        <label class="dw-field dw-field-span">
          <span>{{localize "DOLMENWOOD.Sheet.Advance.Next"}}</span>
          <input type="number" class="is-wide" data-field="xpNext" value="{{xp.next}}" {{#unless canEdit}}disabled{{/unless}}>
        </label>
        {{/if}}

        {{!-- **The share of a divided award this character takes.** It is OSE's
              own field, and it happens to be exactly the book's retainer rule,
              which is why the XP window gets that rule by reading it instead of
              inventing a flag of its own (Player's Book p25).

              It is editable *here* because OSE only offers it in its Tweaks
              dialog — two windows away from the sheet where the number means
              something, and far enough that the XP window could show a badge
              for a setting with no visible way to reach it (Dolmenmaster,
              2026-09-04). Last in the grid so the odd cell falls at the end of
              the block rather than tearing a hole in the middle of it. --}}
        <label class="dw-field" title="{{localize "DOLMENWOOD.Sheet.Experience.ShareHint"}}">
          <span>{{localize "DOLMENWOOD.Sheet.Experience.Share"}}</span>
          <input type="number" class="is-number" data-field="xpShare" value="{{xp.share}}" {{#unless canEdit}}disabled{{/unless}}>
        </label>
      </div>

      {{!-- Levelling up, by the Dolmendudes house rules (docs/Hausregeln.pdf).
            All four routes are always shown, blocked ones included: "1,750 XP
            short of the cap" is the answer to the question actually being
            asked, and a missing button answers nothing. --}}
      {{#if advance}}
      <div class="dw-levelup">
        <div class="dw-levelup-head">
          <span class="dw-levelup-class">{{localize "DOLMENWOOD.Sheet.Advance.Head" class=advance.classLabel level=level}}</span>
          <span class="dw-levelup-cap {{#if advance.atCap}}is-at-cap{{/if}}" title="{{localize "DOLMENWOOD.Sheet.Advance.CapLineHint"}}">
            {{advance.capLine}}
          </span>
        </div>

        {{!-- One line per route: the name, the time it takes, and nothing else
              on the page. The price lives in the tooltip — it is what you want
              to know before pressing and never while scanning the list
              (Dolmenmaster, 2026-09-02: *"den text für kosten weglassen und
              stattdessen nur im mouseover"*). The confirmation dialog spells it
              out again before anything is paid, so nothing is hidden. --}}
        <div class="dw-levelup-routes">
          {{#each advance.routes}}
          <button type="button" class="dw-levelup-route {{#unless this.available}}is-blocked{{/unless}}"
                  data-action="levelUp" data-route="{{this.id}}"
                  {{#unless ../canEdit}}disabled{{/unless}} {{#unless this.available}}disabled{{/unless}}
                  title="{{#if this.blocked}}{{localize "DOLMENWOOD.Sheet.Advance.RouteHintBlocked" label=this.label duration=this.duration cost=this.costNote blocked=this.blocked}}{{else}}{{localize "DOLMENWOOD.Sheet.Advance.RouteHint" label=this.label duration=this.duration cost=this.costNote}}{{/if}}">
            <i class="fas fa-angles-up dw-levelup-mark"></i>
            <span class="dw-levelup-label">{{this.label}}</span>
            <span class="dw-levelup-when">{{#if this.available}}{{this.duration}}{{else}}{{this.blocked}}{{/if}}</span>
          </button>
          {{/each}}
        </div>
      </div>
      {{else}}
      <p class="dw-levelup-none">
        <i class="fas fa-circle-info"></i>
        {{#if identity.class}}
          {{{localize "DOLMENWOOD.Sheet.Advance.UnknownClass" class=identity.class}}}
        {{else}}
          {{localize "DOLMENWOOD.Sheet.Advance.NoClass"}}
        {{/if}}
      </p>
      {{/if}}
    </section>

  </div>

</div>
