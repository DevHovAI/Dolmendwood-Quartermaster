<div class="item-row {{#if item.isSecret}}is-secret{{/if}}" data-item-id="{{item.id}}"{{#if isOwner}} draggable="true"{{/if}}>
  <span class="item-name">
    {{#if item.isSecret}}
    <i class="fas fa-lock secret-icon" title="Secret item"></i>
    {{else if item.def}}
    <i class="fas {{#if item.def.icon}}{{item.def.icon}}{{else}}{{itemIcon item.def.category item.def.subcategory}}{{/if}} item-cat-icon" title="{{item.def.category}}"></i>
    {{else}}
    <i class="fas {{#if item.customDefinition.icon}}{{item.customDefinition.icon}}{{else}}fa-sack{{/if}} item-cat-icon" title="Custom item"></i>
    {{/if}}
    {{item.name}}
    {{#if (eq encMode "weight")}}
      {{#if item.def}}
      <span class="item-size-badge item-weight-badge" title="Weight per unit">{{item.def.weight}} wt</span>
      {{else if item.customDefinition}}
      <span class="item-size-badge item-weight-badge" title="Weight per unit">{{#if item.customDefinition.weight}}{{item.customDefinition.weight}}{{else}}0{{/if}} wt</span>
      {{/if}}
    {{else}}
      {{#if item.def}}
      <span class="item-size-badge size-{{item.def.size}}" title="{{slotCost item.def.size}}">{{sizeLabel item.def.size}}</span>
      {{else if item.customDefinition.size}}
      <span class="item-size-badge size-{{item.customDefinition.size}}" title="{{slotCost item.customDefinition.size}}">{{sizeLabel item.customDefinition.size}}</span>
      {{/if}}
    {{/if}}
    {{#if item.def.cannotBeStowed}}<span class="badge badge-cannot-stow" title="Cannot be stowed">Carried</span>{{/if}}
    {{#if item.def.qualities.length}}<span class="item-qualities">{{#each item.def.qualities}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>{{/if}}
    {{!-- One block, not two: item.def is the *effective* definition, so for a
          custom item it already IS customDefinition. Printing both rendered the
          description twice. --}}
    {{#if item.def.description}}<span class="item-description">{{item.def.description}}</span>{{/if}}
    {{!-- What the Referee knows and the row does not say: the true name of an
          unidentified find, and what eating it does. Rendered for the GM alone
          — the row itself stays in plain sight. --}}
    {{#if isGM}}{{#if item.gmNote}}
    <span class="item-gm-note" title="Only you can see this"><i class="fas fa-user-secret"></i> {{item.gmNote}}</span>
    {{/if}}{{/if}}
  </span>

  {{!-- A quiver, bottle or cask is one object per row, so its quantity is
        always 1 and only the fill level below is worth showing --}}
  {{#unless item.isSingleContainer}}
  {{#if item.isBundle}}
  {{!-- Bundles count loose units, so one control replaces quantity + uses --}}
  {{#if isOwner}}
  <div class="item-qty-controls" title="{{item.units}} left · a bundle of {{item.def.maxUses}} weighs {{item.def.weight}} wt, so each one is {{item.unitWeight}} wt">
    <button type="button" data-action="decrementUnits" data-item-id="{{item.id}}" class="qty-btn" title="Use / consume one">−</button>
    <span class="item-qty">{{item.units}}</span>
    <button type="button" data-action="incrementUnits" data-item-id="{{item.id}}" class="qty-btn" title="Add one">+</button>
  </div>
  {{else}}
  <span class="item-qty-readonly" title="{{item.units}} left">×{{item.units}}</span>
  {{/if}}
  {{else if canEdit}}
  <div class="item-qty-controls">
    <button type="button" data-action="decrementQty" data-item-id="{{item.id}}" class="qty-btn">−</button>
    <span class="item-qty">{{item.quantity}}</span>
    <button type="button" data-action="incrementQty" data-item-id="{{item.id}}" class="qty-btn">+</button>
  </div>
  {{else if isOwner}}
  <div class="item-qty-controls">
    <button type="button" data-action="decrementQty" data-item-id="{{item.id}}" class="qty-btn" title="Use / consume one">−</button>
    <span class="item-qty">{{item.quantity}}</span>
  </div>
  {{else}}
  <span class="item-qty-readonly">×{{item.quantity}}</span>
  {{/if}}
  {{/unless}}

  {{#if item.def.coinCapacity}}
  <div class="item-coin-capacity" title="Coins stored in this container">
    <i class="fas fa-coins" style="font-size:0.8em;opacity:0.6;"></i>
    <span class="coin-capacity-val">{{item.coinsStored}}/{{item.def.coinCapacity}}</span>
  </div>
  {{/if}}

  {{!-- Quivers and quarrel cases keep the container/uses view; bundles fold it
        into the single unit counter above --}}
  {{#if item.def.maxUses}}{{#unless item.isBundle}}
  <div class="item-uses-controls">
    {{#if isOwner}}
    <button type="button" data-action="decrementUses" data-item-id="{{item.id}}"
            class="qty-btn" title="Use one" {{#if (eq item.uses 0)}}disabled{{/if}}>−</button>
    {{/if}}
    <span class="item-uses {{#if (eq item.uses 0)}}uses-empty{{/if}}"
          title="{{item.uses}} / {{item.def.maxUses}} remaining">{{item.uses}}/{{item.def.maxUses}}</span>
    {{#if isOwner}}
    <button type="button" data-action="incrementUses" data-item-id="{{item.id}}"
            class="qty-btn" title="Restore one" {{#if (eq item.uses item.def.maxUses)}}disabled{{/if}}>+</button>
    {{/if}}
  </div>
  {{/unless}}{{/if}}

  {{#if isOwner}}
  <textarea class="item-notes-input" data-item-id="{{item.id}}"
            placeholder="Notes…" title="Notes" rows="1">{{item.notes}}</textarea>
  {{/if}}

  {{!-- What the row is worth, for the Referee alone (Leander, 2026-08-28: *"ich
        als DM hätte gerne die möglichkeit, den Wert von gegenständen im
        inventar der Spieler zu sehen"*). A lane of its own, drawn on every row
        whether or not the thing has a price, so the buttons after it stay in
        their column — and an em dash rather than "0", because a thing the
        catalogue gives no price is not a thing worth nothing. --}}
  {{#if isGM}}
  <span class="item-value" title="{{item.valueTitle}}">{{#if item.valueLabel}}{{item.valueLabel}}{{else}}&mdash;{{/if}}</span>
  {{/if}}

  {{!-- The buttons live in one block of fixed lanes so that the same icon sits
        in the same column on every row. Only the Eat button varies from row to
        row — the others follow the viewer's permissions, which are the same all
        the way down the list — so an inedible item is given an empty lane
        rather than closing the gap and pulling the trash can leftwards. --}}
  <span class="item-actions">
    {{#if isOwner}}
    <button type="button" data-action="toggleSecret" data-item-id="{{item.id}}"
            class="icon-btn secret-btn" title="{{#if item.isSecret}}Make visible{{else}}Make secret{{/if}}">
      <i class="fas {{#if item.isSecret}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
    </button>
    {{/if}}

    {{#if isOwner}}
    {{#if item.isEdible}}
    <button type="button" data-action="eatItem" data-item-id="{{item.id}}"
            class="icon-btn eat-btn" title="Eat one — feeds this character for the day">
      <i class="fas fa-drumstick-bite"></i>
    </button>
    {{else}}
    <span class="icon-slot" aria-hidden="true"></span>
    {{/if}}
    {{/if}}

    {{#if isOwner}}
    <button type="button" data-action="editItem" data-item-id="{{item.id}}"
            class="icon-btn rename-btn" title="Edit this item — its name, and everything else about it">
      <i class="fas fa-pen"></i>
    </button>
    {{/if}}

    {{#if canEdit}}
    <button type="button" data-action="deleteItem" data-item-id="{{item.id}}"
            class="icon-btn delete-btn" title="Remove item">
      <i class="fas fa-trash"></i>
    </button>
    {{/if}}

    {{#if canGive}}
    <button type="button" data-action="giveItem" data-item-id="{{item.id}}"
            class="icon-btn give-btn" title="Give item to another player">
      <i class="fas fa-share"></i>
    </button>
    {{/if}}
  </span>
</div>
