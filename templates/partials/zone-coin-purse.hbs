<div class="zone-coin-purse">
  <i class="fas fa-coins zone-purse-icon" title="{{localize "DOLMENWOOD.Zone.Purse.Hint"}}"></i>

  {{#if canEdit}}
  {{!-- GM: editable coin inputs per zone --}}
  <div class="zone-purse-inputs">
    <input type="number" class="zone-coin-input" data-zone-id="{{zoneId}}" data-currency="pp"
           value="{{zoneCoins.pp}}" min="0" title="{{localize "DOLMENWOOD.Currency.Pellucidium"}}" />
    <span class="zone-coin-label pp">{{localize "DOLMENWOOD.Currency.PP"}}</span>
    <input type="number" class="zone-coin-input" data-zone-id="{{zoneId}}" data-currency="gp"
           value="{{zoneCoins.gp}}" min="0" title="{{localize "DOLMENWOOD.Currency.GoldPieces"}}" />
    <span class="zone-coin-label gp">{{localize "DOLMENWOOD.Currency.GP"}}</span>
    <input type="number" class="zone-coin-input" data-zone-id="{{zoneId}}" data-currency="sp"
           value="{{zoneCoins.sp}}" min="0" title="{{localize "DOLMENWOOD.Currency.SilverPieces"}}" />
    <span class="zone-coin-label sp">{{localize "DOLMENWOOD.Currency.SP"}}</span>
    <input type="number" class="zone-coin-input" data-zone-id="{{zoneId}}" data-currency="cp"
           value="{{zoneCoins.cp}}" min="0" title="{{localize "DOLMENWOOD.Currency.CopperPieces"}}" />
    <span class="zone-coin-label cp">{{localize "DOLMENWOOD.Currency.CP"}}</span>
  </div>
  {{else}}
  {{!-- Non-GM: read-only coin badge --}}
  <div class="zone-purse-readonly">
    {{#if (gt zoneCoins.pp 0)}}<span class="coin-val">{{zoneCoins.pp}}<span class="coin-unit pp">{{localize "DOLMENWOOD.Currency.PP"}}</span></span>{{/if}}
    {{#if (gt zoneCoins.gp 0)}}<span class="coin-val">{{zoneCoins.gp}}<span class="coin-unit gp">{{localize "DOLMENWOOD.Currency.GP"}}</span></span>{{/if}}
    {{#if (gt zoneCoins.sp 0)}}<span class="coin-val">{{zoneCoins.sp}}<span class="coin-unit sp">{{localize "DOLMENWOOD.Currency.SP"}}</span></span>{{/if}}
    {{#if (gt zoneCoins.cp 0)}}<span class="coin-val">{{zoneCoins.cp}}<span class="coin-unit cp">{{localize "DOLMENWOOD.Currency.CP"}}</span></span>{{/if}}
    {{#if (and (eq zoneCoins.pp 0) (eq zoneCoins.gp 0) (eq zoneCoins.sp 0) (eq zoneCoins.cp 0))}}
    <span class="zone-purse-empty">—</span>
    {{/if}}
  </div>
  {{/if}}

  {{#if isOwner}}
  <button type="button" class="icon-btn zone-move-coins-btn" data-action="moveZoneCoins"
          data-zone-id="{{zoneId}}" title="{{localize "DOLMENWOOD.Zone.Purse.Move.Hint"}}">
    <i class="fas fa-arrow-right-arrow-left"></i>
  </button>
  {{/if}}
</div>
