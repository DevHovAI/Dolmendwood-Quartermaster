{{#if (eq encMode "weight")}}
{{!-- ── Weight Encumbrance ── --}}
<div class="encumbrance-bar encumbrance-weight">
  <div class="enc-row enc-total-weight">
    <span class="enc-label">{{localize "DOLMENWOOD.Encumbrance.Weight"}}</span>
    <div class="enc-track" title="{{localize "DOLMENWOOD.Encumbrance.WeightTrack" n=encumbrance.totalWeight}}">
      <div class="enc-fill {{speedColor encumbrance.loadSpeed}}"
           style="width: {{weightBarWidth encumbrance.totalWeight}}"></div>
      <div class="enc-threshold" style="left: 25%"   title="{{localize "DOLMENWOOD.Encumbrance.Threshold" speed=40 coins="400"}}"></div>
      <div class="enc-threshold" style="left: 37.5%" title="{{localize "DOLMENWOOD.Encumbrance.Threshold" speed=30 coins="600"}}"></div>
      <div class="enc-threshold" style="left: 50%"   title="{{localize "DOLMENWOOD.Encumbrance.Threshold" speed=20 coins="800"}}"></div>
      <div class="enc-threshold" style="left: 100%"  title="{{localize "DOLMENWOOD.Encumbrance.MaxLoad"}}"></div>
    </div>
    <span class="enc-slots">{{encumbrance.totalWeight}}</span>
  </div>
  <div class="enc-weight-breakdown">
    <span class="enc-breakdown-item" title="{{localize "DOLMENWOOD.Encumbrance.EqHint"}}">{{localize "DOLMENWOOD.Encumbrance.Eq" n=encumbrance.equippedWeight}}</span>
    <span class="enc-breakdown-sep">·</span>
    <span class="enc-breakdown-item" title="{{localize "DOLMENWOOD.Encumbrance.StHint"}}">{{localize "DOLMENWOOD.Encumbrance.St" n=encumbrance.stowedWeight}}</span>
    <span class="enc-breakdown-sep">·</span>
    <span class="enc-breakdown-item {{#if (gt encumbrance.tinyWeight 50)}}enc-over{{/if}}" title="{{localize "DOLMENWOOD.Encumbrance.PouchHint"}}">{{localize "DOLMENWOOD.Encumbrance.Pouch" n=encumbrance.tinyWeight}}</span>
  </div>
  {{!-- The track says what is carried; this says what that lets you do about it.
        It reads as the arithmetic it is — load, less hunger, equals pace — which
        an arrow tucked against the right end of the track never could. --}}
  {{> speed-readout encumbrance=encumbrance}}
</div>
{{else}}
{{!-- ── Slot Encumbrance (default) ── --}}
<div class="encumbrance-bar">
  <div class="enc-row enc-equipped">
    <span class="enc-label">{{localize "DOLMENWOOD.Encumbrance.Equipped"}}</span>
    <div class="enc-track" title="{{localize "DOLMENWOOD.Encumbrance.SlotTrack" n=encumbrance.equippedSlots max=10}}">
      <div class="enc-fill {{speedColor encumbrance.equippedSpeed}}"
           style="width: {{equippedBarWidth encumbrance.equippedSlots}}"></div>
      <div class="enc-threshold" style="left: 40%" title="{{localize "DOLMENWOOD.Encumbrance.SlotThreshold" speed=30 slots=4}}"></div>
      <div class="enc-threshold" style="left: 60%" title="{{localize "DOLMENWOOD.Encumbrance.SlotThreshold" speed=20 slots=6}}"></div>
      <div class="enc-threshold" style="left: 80%" title="{{localize "DOLMENWOOD.Encumbrance.SlotThreshold" speed=10 slots=8}}"></div>
    </div>
    <span class="enc-slots">{{encumbrance.equippedSlots}}</span>
    <span class="enc-speed {{speedColor encumbrance.equippedSpeed}}">→ {{encumbrance.equippedSpeed}}ft</span>
  </div>
  <div class="enc-row enc-stowed">
    <span class="enc-label">{{localize "DOLMENWOOD.Encumbrance.Stowed"}}</span>
    <div class="enc-track" title="{{localize "DOLMENWOOD.Encumbrance.SlotTrack" n=encumbrance.stowedSlots max=16}}">
      <div class="enc-fill {{speedColor encumbrance.stowedSpeed}}"
           style="width: {{stowedBarWidth encumbrance.stowedSlots}}"></div>
      <div class="enc-threshold" style="left: 68.75%" title="{{localize "DOLMENWOOD.Encumbrance.SlotThreshold" speed=30 slots=11}}"></div>
      <div class="enc-threshold" style="left: 81.25%" title="{{localize "DOLMENWOOD.Encumbrance.SlotThreshold" speed=20 slots=13}}"></div>
      <div class="enc-threshold" style="left: 93.75%" title="{{localize "DOLMENWOOD.Encumbrance.SlotThreshold" speed=10 slots=15}}"></div>
    </div>
    <span class="enc-slots">{{encumbrance.stowedSlots}}</span>
    <span class="enc-speed {{speedColor encumbrance.stowedSpeed}}">→ {{encumbrance.stowedSpeed}}ft</span>
  </div>
  {{!-- The same statement as in weight mode, and for the same reason: the two
        tracks above say what is carried, and this says the pace that comes out
        of it. Here the slower of the two tracks is the starting value, and the
        bottleneck chip names which one it was. --}}
  {{> speed-readout encumbrance=encumbrance}}
</div>
{{/if}}
