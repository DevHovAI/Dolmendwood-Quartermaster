{{#if (eq encMode "weight")}}
{{!-- ── Weight Encumbrance ── --}}
<div class="encumbrance-bar encumbrance-weight">
  <div class="enc-row enc-total-weight">
    <span class="enc-label">Weight</span>
    <div class="enc-track" title="{{encumbrance.totalWeight}} / 1,600 coins">
      <div class="enc-fill {{speedColor encumbrance.loadSpeed}}"
           style="width: {{weightBarWidth encumbrance.totalWeight}}"></div>
      <div class="enc-threshold" style="left: 25%"   title="Speed 40 threshold (400 coins)"></div>
      <div class="enc-threshold" style="left: 37.5%" title="Speed 30 threshold (600 coins)"></div>
      <div class="enc-threshold" style="left: 50%"   title="Speed 20 threshold (800 coins)"></div>
      <div class="enc-threshold" style="left: 100%"  title="Max load (1,600 coins)"></div>
    </div>
    <span class="enc-slots">{{encumbrance.totalWeight}}</span>
  </div>
  <div class="enc-weight-breakdown">
    <span class="enc-breakdown-item" title="Equipped items weight">Eq: {{encumbrance.equippedWeight}}</span>
    <span class="enc-breakdown-sep">·</span>
    <span class="enc-breakdown-item" title="Stowed items weight">St: {{encumbrance.stowedWeight}}</span>
    <span class="enc-breakdown-sep">·</span>
    <span class="enc-breakdown-item {{#if (gt encumbrance.tinyWeight 50)}}enc-over{{/if}}" title="Belt pouch weight (max 50)">Pouch: {{encumbrance.tinyWeight}}/50</span>
  </div>
  {{!-- The track says what is carried; this says what that lets you do about it.
        It reads as the arithmetic it is — load, less hunger, equals pace — which
        an arrow tucked against the right end of the track never could. --}}
  {{> speed-readout encumbrance=encumbrance}}
</div>
{{else}}
{{!-- ── Slot Encumbrance (default) ── --}}
<div class="encumbrance-bar">
  <div class="enc-row enc-equipped">
    <span class="enc-label">Equipped</span>
    <div class="enc-track" title="{{encumbrance.equippedSlots}} / 10 slots">
      <div class="enc-fill {{speedColor encumbrance.equippedSpeed}}"
           style="width: {{equippedBarWidth encumbrance.equippedSlots}}"></div>
      <div class="enc-threshold" style="left: 40%" title="30ft threshold (4 slots)"></div>
      <div class="enc-threshold" style="left: 60%" title="20ft threshold (6 slots)"></div>
      <div class="enc-threshold" style="left: 80%" title="10ft threshold (8 slots)"></div>
    </div>
    <span class="enc-slots">{{encumbrance.equippedSlots}}</span>
    <span class="enc-speed {{speedColor encumbrance.equippedSpeed}}">→ {{encumbrance.equippedSpeed}}ft</span>
  </div>
  <div class="enc-row enc-stowed">
    <span class="enc-label">Stowed</span>
    <div class="enc-track" title="{{encumbrance.stowedSlots}} / 16 slots">
      <div class="enc-fill {{speedColor encumbrance.stowedSpeed}}"
           style="width: {{stowedBarWidth encumbrance.stowedSlots}}"></div>
      <div class="enc-threshold" style="left: 68.75%" title="30ft threshold (11 slots)"></div>
      <div class="enc-threshold" style="left: 81.25%" title="20ft threshold (13 slots)"></div>
      <div class="enc-threshold" style="left: 93.75%" title="10ft threshold (15 slots)"></div>
    </div>
    <span class="enc-slots">{{encumbrance.stowedSlots}}</span>
    <span class="enc-speed {{speedColor encumbrance.stowedSpeed}}">→ {{encumbrance.stowedSpeed}}ft</span>
  </div>
  {{!-- The same statement as in weight mode, and for the same reason: the two
        tracks above say what is carried, and this says the pace that comes out
        of it. Here the slower of the two tracks is the starting value, and the
        bottleneck chip names which one it was. --}}
  {{> speed-readout encumbrance=encumbrance}}
</div>
{{/if}}
