<details class="party-summary">
  <summary><i class="fas fa-scroll"></i> {{localize "DOLMENWOOD.Party.Summary.Title"}}</summary>

  {{!-- Coin totals --}}
  <div class="summary-wealth">
    <div class="summary-coin-row">
      {{#if (gt partySummary.coins.pp 0)}}<span class="summary-coin"><strong>{{partySummary.coins.pp}}</strong> {{localize "DOLMENWOOD.Currency.PP"}}</span>{{/if}}
      {{#if (gt partySummary.coins.gp 0)}}<span class="summary-coin"><strong>{{partySummary.coins.gp}}</strong> {{localize "DOLMENWOOD.Currency.GP"}}</span>{{/if}}
      {{#if (gt partySummary.coins.sp 0)}}<span class="summary-coin"><strong>{{partySummary.coins.sp}}</strong> {{localize "DOLMENWOOD.Currency.SP"}}</span>{{/if}}
      {{#if (gt partySummary.coins.cp 0)}}<span class="summary-coin"><strong>{{partySummary.coins.cp}}</strong> {{localize "DOLMENWOOD.Currency.CP"}}</span>{{/if}}
      {{#unless (gt partySummary.coins.pp 0)}}{{#unless (gt partySummary.coins.gp 0)}}{{#unless (gt partySummary.coins.sp 0)}}{{#unless (gt partySummary.coins.cp 0)}}
      <span class="summary-coin-empty">{{localize "DOLMENWOOD.Party.Summary.NoCoins"}}</span>
      {{/unless}}{{/unless}}{{/unless}}{{/unless}}
    </div>
    <div class="summary-total">≈ {{partySummary.totalGpStr}}</div>
  </div>

  {{!-- Items grouped by category --}}
  {{#if partySummary.hasItems}}
  <div class="summary-item-list">
    {{#each partySummary.grouped}}
    <div class="summary-category">
      <div class="summary-cat-header">
        <i class="fas {{itemIcon @key}}"></i> {{@key}}
      </div>
      {{#each this}}
      <div class="summary-item {{#if this.isSecret}}is-secret{{/if}}">
        <span class="summary-item-name">
          {{#if this.isSecret}}<i class="fas fa-lock" title="{{localize "DOLMENWOOD.Party.Summary.Secret.Hint"}}"></i> {{/if}}
          {{this.name}}
          {{#if (gt this.quantity 1)}}<span class="summary-item-qty">×{{this.quantity}}</span>{{/if}}
        </span>
        <span class="summary-item-owner">{{this.ownerName}}</span>
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>
  {{else}}
  <p class="summary-empty">{{localize "DOLMENWOOD.Party.Summary.NoItems"}}</p>
  {{/if}}
</details>
