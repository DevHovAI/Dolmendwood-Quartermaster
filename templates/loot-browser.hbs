<div class="loot-browser-window">

  {{#if isGM}}
  <div class="loot-toolbar">
    <button type="button" data-action="newBox"><i class="fas fa-plus"></i> {{localize "DOLMENWOOD.Loot.Browser.New"}}</button>
  </div>
  {{/if}}

  {{#if isEmpty}}
  <p class="loot-empty">
    {{#if isGM}}<em>{{localize "DOLMENWOOD.Loot.Browser.Empty.GM"}}</em>{{else}}<em>{{localize "DOLMENWOOD.Loot.Browser.Empty.Player"}}</em>{{/if}}
  </p>
  {{/if}}

  <div class="loot-browser-list">
    {{#each boxes}}
    <button type="button" class="loot-browser-row {{#unless this.released}}is-staged{{/unless}}"
            data-action="openBox" data-actor-id="{{this.id}}">
      <span class="loot-browser-icon"><i class="fas {{this.icon}}"></i></span>
      <span class="loot-browser-text">
        <span class="loot-browser-name">{{this.name}}</span>
        <span class="loot-browser-meta">
          {{localizeN "DOLMENWOOD.Loot.Browser.Meta" this.itemCount}}{{#if this.coinCount}} &middot; {{localize "DOLMENWOOD.Loot.Browser.Coins" n=this.coinCount}}{{/if}}
        </span>
      </span>
      {{#unless this.released}}
      <span class="loot-browser-badge" title="{{localize "DOLMENWOOD.Loot.Browser.Staged.Hint"}}">
        <i class="fas fa-eye-slash"></i> {{localize "DOLMENWOOD.Loot.Browser.Staged.Label"}}
      </span>
      {{/unless}}
    </button>
    {{/each}}
  </div>

</div>
