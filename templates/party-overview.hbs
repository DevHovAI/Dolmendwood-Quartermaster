<div class="party-overview">
  {{!-- Toolbar --}}
  <div class="party-toolbar dw-window-head">
    <i class="fas fa-people-group"></i>
    <h2>{{localize "DOLMENWOOD.Party.Heading"}}</h2>
    {{!-- Marching pace of the whole group, set by its slowest part --}}
    {{#if partyConvoy}}
    <span class="convoy-final {{speedColor partyConvoy.speed}}"
          title="{{#if (gt partyConvoy.slowest.length 1)}}{{localize "DOLMENWOOD.Party.Convoy.PaceTied" count=partyConvoy.slowest.length who=(convoySlowest partyConvoy.slowest true)}}{{else}}{{localize "DOLMENWOOD.Party.Convoy.Pace" who=(convoySlowest partyConvoy.slowest true)}}{{/if}}">
      <i class="fas fa-route"></i> {{localize "DOLMENWOOD.Party.Convoy.Label" speed=(speedLabel partyConvoy.speed)}}
      <span class="convoy-slowest">— {{convoySlowest partyConvoy.slowest}}</span>
    </span>
    {{/if}}
    <div class="toolbar-buttons">
      {{#if isGM}}
      {{!-- The second door to the XP window, and the one that survives the
            bar-only setting folding the toolbar away. This is the window that
            already shows every character at once, which is the same thought. --}}
      <button type="button" data-action="openXp" class="btn-toolbar"
              title="{{localize "DOLMENWOOD.Party.Xp.Hint"}}">
        <i class="fas fa-star"></i> XP
      </button>
      {{/if}}
      <button type="button" data-action="openShop" class="btn-toolbar btn-shop">
        <i class="fas fa-store"></i> {{localize "DOLMENWOOD.Party.OpenShop"}}
      </button>
    </div>
  </div>

  {{!-- Loose gear is the thing to settle before anything else moves: it counts
        against the carrier, it has no home, and only this window shows the
        whole party at once. --}}
  {{#if unsorted}}
  <div class="party-unsorted">
    <i class="fas fa-exclamation-triangle"></i>
    <span>
      {{!-- Two counts, two plurals: how many items, and how many people carry
            them. English happened to inflect both with the same letter; German
            does not, so each is its own key. --}}
      {{{localizeN "DOLMENWOOD.Party.Unsorted.Count" unsorted.items}}}
      — {{localizeN "DOLMENWOOD.Party.Unsorted.Who" unsorted.memberCount who=unsorted.who}}
      {{localize "DOLMENWOOD.Party.Unsorted.Advice"}}
    </span>
  </div>
  {{/if}}

  {{#if hasColumns}}
  {{!-- Party Grid --}}
  <div class="party-grid" style="grid-template-columns: {{gridTemplate}};">
    {{#each members}}
    <div class="player-column" data-actor-id="{{this.actorId}}">
      {{!-- Name, bars and coins stay pinned while the item list scrolls --}}
      <div class="player-col-sticky">
      {{!-- Player header. No inventory button — clicking the column opens it. --}}
      <div class="player-col-header">
        <span class="player-name" title="{{this.actor.name}}">{{this.actor.name}}</span>
        {{!-- The column itself opens the inventory, so the sheet needs a door of
              its own. A button, because the column's own handler steps aside for
              one. --}}
        <button type="button" class="player-sheet-btn" data-action="openSheet"
                data-actor-id="{{this.actorId}}" title="{{localize "DOLMENWOOD.Party.Sheet.Hint" name=this.actor.name}}">
          <i class="fas fa-scroll"></i>
        </button>
        <span class="player-speed {{speedColor this.encumbrance.finalSpeed}}">
          {{speedLabel this.encumbrance.finalSpeed}}
          {{#if (eq ../encMode "slots")}}
          {{#if (neq this.encumbrance.bottleneck "none")}}
          <i class="fas fa-exclamation-triangle" title="{{localize "DOLMENWOOD.Party.Bottleneck" what=(bottleneckLabel this.encumbrance.bottleneck)}}"></i>
          {{/if}}
          {{/if}}
        </span>
      </div>

      {{!-- Encumbrance bars --}}
      <div class="player-bars">
        {{#if (eq ../encMode "weight")}}
        <div class="bar-row">
          <span class="bar-label">{{localize "DOLMENWOOD.Party.Bar.Weight"}}</span>
          <div class="bar-track">
            <div class="bar-fill {{speedColor this.encumbrance.finalSpeed}}"
                 style="width: {{weightBarWidth this.encumbrance.totalWeight}}"
                 title="{{localize "DOLMENWOOD.Party.Bar.TotalWeight" n=this.encumbrance.totalWeight}}"></div>
            <div class="bar-threshold" style="left: 25%"   title="{{localize "DOLMENWOOD.Party.Bar.ThresholdWeight" from=40 to=30 at=400}}"></div>
            <div class="bar-threshold" style="left: 37.5%" title="{{localize "DOLMENWOOD.Party.Bar.ThresholdWeight" from=30 to=20 at=600}}"></div>
            <div class="bar-threshold" style="left: 50%"   title="{{localize "DOLMENWOOD.Party.Bar.ThresholdWeight" from=20 to=10 at=800}}"></div>
          </div>
          <span class="bar-val">{{this.encumbrance.totalWeight}}</span>
        </div>
        {{else}}
        <div class="bar-row">
          <span class="bar-label">{{localize "DOLMENWOOD.Party.Bar.Equipped"}}</span>
          <div class="bar-track">
            <div class="bar-fill {{speedColor this.encumbrance.equippedSpeed}}"
                 style="width: {{equippedBarWidth this.encumbrance.equippedSlots}}"
                 title="{{localize "DOLMENWOOD.Party.Bar.EquippedSlots" n=this.encumbrance.equippedSlots}}"></div>
            <div class="bar-threshold" style="left: 40%" title="{{localize "DOLMENWOOD.Party.Bar.ThresholdSlots" ft=30 n=4}}"></div>
            <div class="bar-threshold" style="left: 60%" title="{{localize "DOLMENWOOD.Party.Bar.ThresholdSlots" ft=20 n=6}}"></div>
            <div class="bar-threshold" style="left: 80%" title="{{localize "DOLMENWOOD.Party.Bar.ThresholdSlots" ft=10 n=8}}"></div>
          </div>
          <span class="bar-val">{{this.encumbrance.equippedSlots}}</span>
        </div>
        <div class="bar-row">
          <span class="bar-label">{{localize "DOLMENWOOD.Party.Bar.Stowed"}}</span>
          <div class="bar-track">
            <div class="bar-fill {{speedColor this.encumbrance.stowedSpeed}}"
                 style="width: {{stowedBarWidth this.encumbrance.stowedSlots}}"
                 title="{{localize "DOLMENWOOD.Party.Bar.StowedSlots" n=this.encumbrance.stowedSlots}}"></div>
            <div class="bar-threshold" style="left: 68.75%" title="{{localize "DOLMENWOOD.Party.Bar.ThresholdSlots" ft=30 n=11}}"></div>
            <div class="bar-threshold" style="left: 81.25%" title="{{localize "DOLMENWOOD.Party.Bar.ThresholdSlots" ft=20 n=13}}"></div>
            <div class="bar-threshold" style="left: 93.75%" title="{{localize "DOLMENWOOD.Party.Bar.ThresholdSlots" ft=10 n=15}}"></div>
          </div>
          <span class="bar-val">{{this.encumbrance.stowedSlots}}</span>
        </div>
        {{/if}}
      </div>

      {{!-- Coins summary --}}
      <div class="player-coins">
        {{> coin-display inventory=this.inventory encumbrance=this.encumbrance canEdit=false}}
      </div>
      </div>{{!-- /.player-col-sticky --}}

      {{!-- Item list grouped by zone --}}
      <div class="player-items-compact">
        {{#each this.zoneSections}}
        <div class="zone-section-compact">
          <div class="zone-section-compact-header">{{this.name}}</div>
          {{#each this.items}}
          {{#if this.isSecret}}
          <div class="item-compact secret-item">
            <i class="fas fa-lock"></i> <em>{{localize "DOLMENWOOD.Party.Hidden"}}</em>
          </div>
          {{else}}
          <div class="item-compact">
            <span class="item-compact-name">{{this.name}}</span>
            <span class="item-compact-qty">×{{this.quantity}}</span>
          </div>
          {{/if}}
          {{/each}}
        </div>
        {{/each}}
      </div>
    </div>
    {{/each}}

    {{!-- Shared party store: narrower card, no encumbrance bars — it carries
          nothing itself, it only holds what the party put in it. --}}
    {{#if sharedMember}}
    <div class="player-column shared-column" data-actor-id="{{sharedMember.actorId}}">
      <div class="player-col-sticky">
        <div class="player-col-header">
          <span class="player-name" title="{{sharedMember.actor.name}}"><i class="fas fa-people-group"></i> {{sharedMember.actor.name}}</span>
        </div>
        <div class="player-coins">
          {{> coin-display inventory=sharedMember.inventory encumbrance=sharedMember.encumbrance canEdit=false}}
        </div>
      </div>

      <div class="player-items-compact">
        {{#each sharedMember.zoneSections}}
        <div class="zone-section-compact">
          <div class="zone-section-compact-header">{{this.name}}</div>
          {{#each this.items}}
          <div class="item-compact">
            <span class="item-compact-name">{{this.name}}</span>
            <span class="item-compact-qty">×{{this.quantity}}</span>
          </div>
          {{/each}}
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}
  </div>

  {{!-- Party Gear & Wealth summary --}}
  {{> party-summary partySummary=partySummary}}

  {{else}}
  <div class="party-empty">
    <p>{{localize "DOLMENWOOD.Party.Empty"}}</p>
  </div>
  {{/if}}

  {{!-- Recent Transactions --}}
  {{#if transactions.length}}
  <details class="party-transactions">
    <summary><i class="fas fa-scroll"></i> {{localize "DOLMENWOOD.Party.Transactions"}}</summary>
    {{> transaction-log transactions=transactions}}
  </details>
  {{/if}}
</div>
