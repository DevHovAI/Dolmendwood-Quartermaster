<div class="shop-panel">
  {{!-- Shop Header --}}
  <div class="shop-header">
    {{!-- The place-less shop is named, stocked and opened here, exactly as the
          inn is: it has no note to carry any of that. A shop on the map has
          one, so it gets a plain title and none of these controls. --}}
    <div class="dw-window-head">
      <i class="fas fa-store"></i>
      {{#if canRelease}}
      <input type="text" id="shop-name-input" class="dw-title-input" value="{{toolbarName}}"
             placeholder="{{localize "DOLMENWOOD.Shop.Name.Placeholder"}}" title="{{localize "DOLMENWOOD.Shop.Name.Hint"}}" />
      {{else}}
      <h2>{{shopName}}</h2>
      {{/if}}
      <span class="dw-window-head-extra">
        {{#if (neq priceFactor 100)}}<span class="price-factor-badge" title="{{localize "DOLMENWOOD.Shop.PriceFactor.Hint" pct=priceFactor}}">{{priceFactor}}%</span>{{/if}}
        {{#if buysAnything}}<span class="buy-back-badge" title="{{localize "DOLMENWOOD.Shop.BuyBack.Hint" pct=buyBackRate}}">{{localize "DOLMENWOOD.Shop.BuyBack.Badge" pct=buyBackRate}}</span>{{/if}}

        {{#if canRelease}}
        {{!-- Which of the two the shop is showing. It starts on its own shelf,
              which is what makes it empty until the Referee stocks it. --}}
        <button type="button" class="dw-shelf-btn" data-action="toggleOwnStock"
                title="{{#if ownStockOnly}}{{localize "DOLMENWOOD.Shop.Shelf.Own.Hint"}}{{else}}{{localize "DOLMENWOOD.Shop.Shelf.Catalogue.Hint"}}{{/if}}">
          <i class="fas {{#if ownStockOnly}}fa-list-check{{else}}fa-book-open{{/if}}"></i>
          {{#if ownStockOnly}}{{localize "DOLMENWOOD.Shop.Shelf.Own.Label"}}{{else}}{{localize "DOLMENWOOD.Shop.Shelf.Catalogue.Label"}}{{/if}}
        </button>

        <button type="button" class="dw-release-btn {{#if released}}is-released{{else}}is-staged{{/if}}"
                data-action="toggleRelease"
                title="{{#if released}}{{localize "DOLMENWOOD.Shop.Release.Open.Hint"}}{{else}}{{localize "DOLMENWOOD.Shop.Release.Closed.Hint"}}{{/if}}">
          <i class="fas {{#if released}}fa-door-open{{else}}fa-door-closed{{/if}}"></i>
          {{#if released}}{{localize "DOLMENWOOD.Shop.Release.Open.Label"}}{{else}}{{localize "DOLMENWOOD.Shop.Release.Closed.Label"}}{{/if}}
        </button>
        {{/if}}
      </span>
    </div>

    {{!-- Target actor selector (GM can pick any party member; players buy for themselves) --}}
    {{#if isGM}}
    <div class="shop-target">
      <label for="shop-target-actor">{{localize "DOLMENWOOD.Shop.BuyingFor"}}:</label>
      <select id="shop-target-actor">
        <option value="">{{localize "DOLMENWOOD.Shop.SelectMember"}}</option>
        {{#each partyMembers}}
        <option value="{{this.id}}" {{#if (eq this.id ../selectedActorId)}}selected{{/if}}>
          {{this.name}}
        </option>
        {{/each}}
      </select>
    </div>
    {{else}}
    <div class="shop-target">
      <span>{{localize "DOLMENWOOD.Shop.BuyingFor"}}: <strong>{{selectedActor.name}}</strong></span>
    </div>
    {{/if}}

    {{!-- What the buyer can actually spend. The shop has always known this —
          the Affordable filter is built on it — but never said it, so the one
          number you want while shopping was the one you had to leave the window
          to find. --}}
    {{#if selectedActor}}
    <div class="shop-coins" title="{{localize "DOLMENWOOD.Shop.Coins.Hint" name=selectedActor.name}}">
      <i class="fas fa-coins"></i>
      <span class="shop-coins-label">{{localize "DOLMENWOOD.Shop.Coins.Label"}}</span>
      {{#if (gt selectedInventory.coins.pp 0)}}<span class="coin-val">{{selectedInventory.coins.pp}}<span class="coin-unit pp">{{localize "DOLMENWOOD.Currency.PP"}}</span></span>{{/if}}
      <span class="coin-val">{{selectedInventory.coins.gp}}<span class="coin-unit gp">{{localize "DOLMENWOOD.Currency.GP"}}</span></span>
      <span class="coin-val">{{selectedInventory.coins.sp}}<span class="coin-unit sp">{{localize "DOLMENWOOD.Currency.SP"}}</span></span>
      <span class="coin-val">{{selectedInventory.coins.cp}}<span class="coin-unit cp">{{localize "DOLMENWOOD.Currency.CP"}}</span></span>
    </div>
    {{/if}}

    {{!-- Selected actor encumbrance summary --}}
    {{#if selectedActor}}
    <div class="shop-target-summary">
      <span>{{selectedActor.name}}:</span>
      {{> encumbrance-bar encumbrance=selectedEncumbrance encMode=encMode}}
    </div>
    {{/if}}
  </div>

  {{!-- Tag Filters: catalogue tags, so a shop keeping to its own shelf has none --}}
  {{#unless ownStockOnly}}
  {{#if allTags.length}}
  <div class="shop-tag-filters">
    <span class="tag-filter-label">{{localize "DOLMENWOOD.Shop.Tags"}}:</span>
    {{#each allTags}}
    <button type="button" class="tag-chip {{#if (includes ../shopState.activeTags this)}}active{{/if}}"
            data-action="toggleTag" data-tag="{{this}}">
      {{this}}
    </button>
    {{/each}}
  </div>
  {{/if}}
  {{/unless}}

  {{!-- Search --}}
  <div class="shop-search">
    <input type="text" id="shop-search" placeholder="{{localize "DOLMENWOOD.Shop.Search"}}" value="{{searchText}}" />
    {{#if selectedActor}}
    <button type="button" data-action="toggleAffordable"
            class="btn-affordable {{#if showAffordableOnly}}active{{/if}}"
            title="{{localize "DOLMENWOOD.Shop.Affordable.Hint"}}">
      <i class="fas fa-coins"></i> {{localize "DOLMENWOOD.Shop.Affordable.Label"}}
    </button>
    {{/if}}
    {{#if buysAnything}}
    {{#if selectedActor}}
    <button type="button" data-action="toggleSelling"
            class="btn-sell-toggle {{#if selling}}active{{/if}}"
            title="{{#if selling}}{{localize "DOLMENWOOD.Shop.Shelves.Hint"}}{{else}}{{localize "DOLMENWOOD.Shop.SellMode.Hint" name=selectedActor.name pct=buyBackRate}}{{/if}}">
      <i class="fas {{#if selling}}fa-shelves{{else}}fa-hand-holding-dollar{{/if}}"></i> {{#if selling}}{{localize "DOLMENWOOD.Shop.Shelves.Label"}}{{else}}{{localize "DOLMENWOOD.Shop.SellMode.Label"}}{{/if}}
    </button>
    {{/if}}
    {{/if}}
  </div>

  {{!-- **Stocking the shop is the Referee's row, and its own.** The two jobs
        were one line: searching and buying, which everyone does, beside filling
        the shelves, which only the Referee does. Seven controls fitted in
        English and not in German (Leander, 2026-09-05), and splitting them by
        who uses them is the answer that also reads better — the toolbar now
        says what is yours and what is his. --}}
  {{#if isGM}}
  <div class="shop-gm-tools">
    <button type="button" data-action="addToShop" class="btn-add-to-shop"
            title="{{#if isLocalShop}}{{localize "DOLMENWOOD.Shop.AddToShop.HintLocal"}}{{else}}{{localize "DOLMENWOOD.Shop.AddToShop.HintGeneral"}}{{/if}}">
      <i class="fas fa-plus"></i> {{localize "DOLMENWOOD.Shop.AddToShop.Label"}}
    </button>
    <button type="button" data-action="stockFromCatalogue" class="btn-add-to-shop"
            title="{{localize "DOLMENWOOD.Shop.FromCatalogue.Hint"}}">
      <i class="fas fa-book"></i> {{localize "DOLMENWOOD.Shop.FromCatalogue.Label"}}
    </button>
    <button type="button" data-action="stockFromLibrary" class="btn-add-to-shop"
            title="{{localize "DOLMENWOOD.Shop.AddService.Hint"}}">
      <i class="fas fa-hand-holding-dollar"></i> {{localize "DOLMENWOOD.Shop.AddService.Label"}}
    </button>
    {{#if hasChancyStock}}
    <button type="button" data-action="newVisit" class="btn-add-to-shop"
            title="{{localize "DOLMENWOOD.Shop.NewVisit.Hint" n=visit}}">
      <i class="fas fa-dice-d6"></i> {{localize "DOLMENWOOD.Shop.NewVisit.Label"}}
    </button>
    {{/if}}
  </div>
  {{/if}}

  {{#if selling}}
  {{!-- ── Selling: what the character carries, and what this shop would pay ── --}}
  <div class="shop-catalog shop-sell">
    <p class="shop-sell-note">
      <i class="fas fa-circle-info"></i>
      {{{localize "DOLMENWOOD.Shop.SellView.Note" shop=shopName pct=buyBackRate}}}
      {{#if buysOnlyItsTrade}}{{{localize "DOLMENWOOD.Shop.SellView.OnlyTrade" list=buyCategoryList}}}{{/if}}
      {{localize "DOLMENWOOD.Shop.SellView.NoZones"}}
    </p>
    {{#if sellRows.length}}
    <div class="shop-item-list">
      {{#each sellRows}}
      <div class="shop-item shop-sell-row {{#if this.worthless}}shop-item-hidden{{/if}}">
        <div class="shop-item-info">
          <span class="shop-item-name">
            <i class="fas {{#if this.icon}}{{this.icon}}{{else}}fa-sack{{/if}} shop-item-icon"></i>
            {{this.name}}
            {{#if this.fill}}
            <span class="shop-sell-count" title="{{localize "DOLMENWOOD.Shop.SellView.Fill.Hint"}}">{{localize "DOLMENWOOD.Shop.SellView.Fill.Label" used=this.fill.used capacity=this.fill.capacity}}</span>
            {{else}}
            <span class="shop-sell-count" title="{{localize "DOLMENWOOD.Shop.SellView.InHand.Hint" name=@root.selectedActor.name}}">{{localize "DOLMENWOOD.Shop.SellView.InHand.Label" n=this.quantity}}</span>
            {{/if}}
          </span>
        </div>
        <div class="shop-item-meta">
          {{#if this.worthless}}
          <span class="shop-item-cost">{{localize "DOLMENWOOD.Shop.SellView.Worthless"}}</span>
          {{else}}
          <span class="shop-item-cost">{{localize "DOLMENWOOD.Shop.SellView.Each" cost=this.perItemText}}</span>
          {{#if (neq this.quantity 1)}}
          <span class="shop-sell-total" title="{{localize "DOLMENWOOD.Shop.SellView.All.Hint" n=this.quantity}}">{{localize "DOLMENWOOD.Shop.SellView.All.Label" cost=this.totalText}}</span>
          {{/if}}
          {{/if}}
        </div>
        <div class="shop-item-actions">
          {{#unless this.worthless}}
          <button type="button" data-action="sellItem" data-item-id="{{this.id}}"
                  class="btn-purchase" title="{{localize "DOLMENWOOD.Shop.SellView.Button.Hint" shop=@root.shopName}}">
            <i class="fas fa-hand-holding-dollar"></i> {{localize "DOLMENWOOD.Shop.SellView.Button.Label"}}
          </button>
          {{/unless}}
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="shop-sell-empty">{{localize "DOLMENWOOD.Shop.SellView.Empty" name=selectedActor.name}}</p>
    {{/if}}
  </div>

  {{else}}
  {{!-- Item Catalog grouped by category → subcategory --}}
  <div class="shop-catalog">
    {{#each grouped}}
    {{!-- data-sync: ApplicationV2 preserves the open state of details across re-renders --}}
    <details class="shop-category" data-sync="{{@key}}">
      <summary class="shop-category-name">{{@key}}</summary>
      <div class="shop-category-body">
        {{#each this}}
        {{!-- subcategory group: this = { subcategory, items } --}}
        {{#if this.subcategory}}
        <div class="shop-subcategory-header">{{this.subcategory}}</div>
        {{/if}}
        <div class="shop-item-list">
          {{#each this.items}}
          {{!-- item: use @root for top-level context --}}
          <div class="shop-item {{#if this.isHidden}}shop-item-hidden{{/if}} {{#if this.isLocalCustom}}shop-item-custom{{/if}} {{#if this.isService}}shop-item-service{{/if}} {{#if this.outOfStock}}shop-item-out{{/if}}" data-item-id="{{this.id}}">
            <div class="shop-item-info">
              <span class="shop-item-name">
                <i class="fas {{#if this.icon}}{{this.icon}}{{else}}{{itemIcon this.category this.subcategory}}{{/if}} shop-item-icon" title="{{this.category}}"></i>
                {{this.name}}
                {{#if this.isService}}<span class="shop-service-badge" title="{{localize "DOLMENWOOD.Shop.Badge.Service.Hint"}}"><i class="fas fa-hand-holding-dollar"></i></span>{{/if}}
                {{#if this.isHidden}}<span class="shop-hidden-badge" title="{{localize "DOLMENWOOD.Shop.Badge.Hidden.Hint"}}"><i class="fas fa-eye-slash"></i></span>{{/if}}
                {{#if this.outOfStock}}<span class="shop-out-badge" title="{{localize "DOLMENWOOD.Shop.Badge.Out.Hint" n=this.availability}}">{{localize "DOLMENWOOD.Shop.Badge.Out.Label"}}</span>{{/if}}
                {{#if this.isLocalCustom}}{{#unless this.isService}}<span class="shop-custom-badge" title="{{localize "DOLMENWOOD.Shop.Badge.Custom.Hint"}}"><i class="fas fa-plus-circle"></i></span>{{/unless}}{{/if}}
              </span>
              {{#if this.description}}<span class="shop-item-desc-inline">{{this.description}}</span>{{/if}}
              {{#if this.qualities.length}}
              <span class="shop-item-qualities">{{#each this.qualities}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>
              {{/if}}
            </div>
            <div class="shop-item-meta">
              {{#if this.isService}}
              {{!-- No size, no weight: nothing is carried away. The unit takes that column instead. --}}
              {{#if this.availability}}
              <span class="shop-item-size shop-chance-badge" title="{{localize "DOLMENWOOD.Shop.Badge.Chance.Hint" n=this.availability}}">{{localize "DOLMENWOOD.Shop.Badge.Chance.Label" n=this.availability}}</span>
              {{/if}}
              {{else}}
              {{#if (eq @root.encMode "weight")}}
              <span class="shop-item-size item-weight-badge" title="{{localize "DOLMENWOOD.Shop.Weight.Hint"}}">{{this.weight}} wt</span>
              {{else}}
              <span class="shop-item-size size-{{this.size}}" title="{{slotCost this.size}}">{{sizeLabel this.size}}</span>
              {{/if}}
              {{#if this.availability}}
              <span class="shop-item-size shop-chance-badge" title="{{localize "DOLMENWOOD.Shop.Badge.Chance.Hint" n=this.availability}}">{{localize "DOLMENWOOD.Shop.Badge.Chance.Label" n=this.availability}}</span>
              {{/if}}
              {{/if}}
              <span class="shop-item-cost">
                {{#if this.byArrangement}}{{localize "DOLMENWOOD.Shop.ByArrangement"}}{{else}}{{this.cost.amount}} {{this.cost.currencyLabel}}{{/if}}
                {{#if this.unit}}{{#if (neq this.unit "piece")}}<span class="shop-item-unit">{{this.unit}}</span>{{/if}}{{/if}}
              </span>
            </div>
            <div class="shop-item-actions">
              {{#unless this.isHidden}}
              {{#unless this.outOfStock}}
              <button type="button" data-action="purchaseItem" data-item-id="{{this.id}}"
                      class="btn-purchase" title="{{#if this.isService}}{{localize "DOLMENWOOD.Shop.Pay.Hint"}}{{else}}{{localize "DOLMENWOOD.Shop.Buy.Hint"}}{{/if}}">
                <i class="fas {{#if this.isService}}fa-hand-holding-dollar{{else}}fa-shopping-cart{{/if}}"></i> {{#if this.isService}}{{localize "DOLMENWOOD.Shop.Pay.Label"}}{{else}}{{localize "DOLMENWOOD.Shop.Buy.Label"}}{{/if}}
              </button>
              {{/unless}}
              {{/unless}}
              {{#if @root.isGM}}
              {{#unless this.isHidden}}
              {{#unless this.outOfStock}}
              <button type="button" data-action="grantItem" data-item-id="{{this.id}}"
                      class="btn-grant" title="{{#if this.isService}}{{localize "DOLMENWOOD.Shop.GrantService.Hint"}}{{else}}{{localize "DOLMENWOOD.Shop.GrantGoods.Hint"}}{{/if}}">
                <i class="fas fa-gift"></i> {{localize "DOLMENWOOD.Shop.Grant"}}
              </button>
              {{/unless}}
              {{/unless}}
              {{#unless this.isLocalCustom}}
              <button type="button"
                      data-action="{{#if @root.isLocalShop}}toggleLocalHideItem{{else}}toggleHideItem{{/if}}"
                      data-item-id="{{this.id}}"
                      class="icon-btn btn-hide-item {{#if this.isHidden}}is-hidden{{/if}}"
                      title="{{#if this.isHidden}}{{localize "DOLMENWOOD.Shop.Show.Hint"}}{{else}}{{localize "DOLMENWOOD.Shop.Hide.Hint"}}{{/if}}">
                <i class="fas {{#if this.isHidden}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
              </button>
              {{/unless}}
              {{#if this.isService}}
              <button type="button" data-action="saveToLibrary" data-item-id="{{this.id}}"
                      class="icon-btn btn-save-library" title="{{localize "DOLMENWOOD.Shop.SaveLibrary.Hint"}}">
                <i class="fas fa-box-archive"></i>
              </button>
              {{/if}}
              {{#if this.isLocalCustom}}
              <button type="button" data-action="editShopEntry" data-item-id="{{this.id}}"
                      class="icon-btn btn-edit-shop-entry" title="{{localize "DOLMENWOOD.Shop.EditEntry.Hint"}}">
                <i class="fas fa-pen"></i>
              </button>
              <button type="button" data-action="removeFromShop" data-item-id="{{this.id}}"
                      class="icon-btn btn-remove-from-shop" title="{{localize "DOLMENWOOD.Shop.RemoveEntry.Hint"}}">
                <i class="fas fa-trash"></i>
              </button>
              {{/if}}
              {{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        {{/each}}
      </div>
    </details>
    {{/each}}
  </div>
  {{/if}}

  {{!-- Transaction Log --}}
  {{> transaction-log transactions=[]}}
</div>
