<div class="market-panel">
  <div class="market-header dw-window-head">
    <i class="fas fa-map-signs"></i>
    <h2>{{marketName}}</h2>
  </div>

  <div class="market-entries">
    {{#each entries}}
    <div class="market-entry">
      <div class="market-entry-icon">
        <i class="fas {{#if this.icon}}{{this.icon}}{{else}}{{#if (eq this.type 'shop')}}fa-store{{else}}fa-beer-mug-empty{{/if}}{{/if}}"></i>
      </div>
      <div class="market-entry-info">
        <span class="market-entry-name">
          {{this.name}}
          {{#if this.priceFactor}}{{#if (neq this.priceFactor 100)}}<span class="price-factor-badge" title="{{localize "DOLMENWOOD.Market.Entry.PriceFactor.Hint" pct=this.priceFactor}}">{{this.priceFactor}}%</span>{{/if}}{{/if}}
        </span>
        {{#if this.description}}
        <span class="market-entry-desc">{{this.description}}</span>
        {{/if}}
        {{#if (eq this.type 'inn')}}
        {{!-- The label, not the stored key: this used to print "common" in
              lower case straight out of the flag. --}}
        <span class="market-entry-quality">{{this.qualityLabel}}</span>
        {{/if}}
      </div>
      <div class="market-entry-actions">
        <button type="button" class="btn-market-open" data-action="openEntry"
                data-entry-id="{{this.id}}" title="{{localize "DOLMENWOOD.Market.Entry.Open.Hint" name=this.name}}">
          <i class="fas fa-door-open"></i> {{localize "DOLMENWOOD.Market.Entry.Enter"}}
        </button>
        {{#if ../isGM}}
        <button type="button" class="icon-btn" data-action="editEntry"
                data-entry-id="{{this.id}}" title="{{localize "DOLMENWOOD.Market.Entry.Edit.Hint"}}">
          <i class="fas fa-pencil"></i>
        </button>
        <button type="button" class="icon-btn btn-danger" data-action="removeEntry"
                data-entry-id="{{this.id}}" title="{{localize "DOLMENWOOD.Market.Entry.Remove.Hint"}}">
          <i class="fas fa-trash"></i>
        </button>
        {{/if}}
      </div>
    </div>
    {{else}}
    <p class="market-empty">{{localize "DOLMENWOOD.Market.Empty.Text"}}
      {{#if isGM}} {{localize "DOLMENWOOD.Market.Empty.GMHint"}}{{/if}}</p>
    {{/each}}
  </div>

  {{#if isGM}}
  <div class="market-add-btns">
    <button type="button" data-action="addEntry" data-type="shop" class="btn-market-add">
      <i class="fas fa-store"></i> {{localize "DOLMENWOOD.Market.AddShop"}}
    </button>
    <button type="button" data-action="addEntry" data-type="inn" class="btn-market-add">
      <i class="fas fa-beer-mug-empty"></i> {{localize "DOLMENWOOD.Market.AddInn"}}
    </button>
  </div>
  {{/if}}
</div>
