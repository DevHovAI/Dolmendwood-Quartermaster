{{!-- One root node: a Handlebars part is rendered as a single element, and the
      strip plus the unfolded panel as two roots lost the bar entirely. --}}
<div class="day-bar-root">

<div class="day-bar-strip {{#if collapsed}}is-collapsed{{/if}}">

  {{!-- Which procedure the day is in decides what the whole list below says, so
        it sits on its own line rather than among the ticks it governs. --}}
  <div class="day-bar-row day-bar-row-top">
    <div class="day-bar-day">
      {{#if isGM}}
      <button type="button" class="day-bar-icon-btn" data-action="newDay" title="Move on to the next in-game day">
        <i class="fas fa-forward"></i>
      </button>
      {{/if}}
    </div>

    {{#unless collapsed}}
    <div class="day-bar-modes">
      {{#each modes}}
      {{#if ../isGM}}
      <button type="button" class="day-bar-mode {{#if this.active}}is-active{{/if}}"
              data-action="setMode" data-mode="{{this.id}}" title="{{this.label}} procedure">
        <i class="fas {{this.icon}}"></i><span class="day-bar-mode-label">{{this.label}}</span>
      </button>
      {{else}}
      {{#if this.active}}
      <span class="day-bar-mode is-active" title="What the party is doing today">
        <i class="fas {{this.icon}}"></i><span class="day-bar-mode-label">{{this.label}}</span>
      </span>
      {{/if}}
      {{/if}}
      {{/each}}
    </div>
    {{/unless}}
    {{!-- Travel Points sit on the top line in every mode, not only in travel:
          how far the party can still get today is asked mid-sentence, and it
          used to be a row that appeared and vanished with the mode. --}}
    {{#if collapsed}}
    {{!-- The folded handle. Read-only: the controls need the room they have when
          the bar is open, and a chip here leads to them instead. --}}
    <div class="day-bar-folded">
      {{#if travelPoints.hasBudget}}
      <span class="day-bar-tp-value {{#if travelPoints.spent}}is-spent{{/if}}" title="{{travelPoints.budgetTitle}}">
        <strong class="{{#if travelPoints.over}}is-over{{/if}}">{{travelPoints.used}}</strong>/{{travelPoints.total}} TP
      </span>
      {{/if}}
      {{#if travelPoints.forced}}
      <span class="day-bar-tp-march is-forced" title="{{travelPoints.forcedTitle}}">
        <i class="fas fa-person-running-fast"></i>
      </span>
      {{/if}}
      {{#if travelPoints.weatherCost}}
      <span class="day-bar-tp-weather {{#if travelPoints.weatherStopped}}is-bad{{/if}}" title="{{travelPoints.budgetTitle}}">
        <i class="fas fa-cloud-showers-heavy"></i>&minus;{{travelPoints.weatherCost}}
      </span>
      {{/if}}
      {{#if context.moved}}
      <button type="button" class="day-bar-context-moved" data-action="expandToContext"
              title="{{context.moved.title}}">
        <i class="fas fa-triangle-exclamation"></i>
      </button>
      {{/if}}
      {{#if warnings}}
      <button type="button" class="day-bar-chip is-warning" data-action="expandToPanel"
              title="{{warningsTitle}}">
        <i class="fas fa-heart-crack"></i> {{warnings}}
      </button>
      {{/if}}
    </div>
    {{/if}}

    {{#unless collapsed}}
    <div class="day-bar-tp {{#if travelPoints.spent}}is-spent{{/if}} {{#if travelPoints.forced}}is-forced{{/if}}">
      {{#if isGM}}
      <button type="button" class="day-bar-tp-march {{#if travelPoints.forced}}is-forced{{/if}}"
              data-action="toggleForcedMarch" title="{{travelPoints.forcedTitle}}">
        <i class="fas {{#if travelPoints.forced}}fa-person-running-fast{{else}}fa-shoe-prints{{/if}}"></i>
      </button>
      {{else}}{{#if travelPoints.forced}}
      <span class="day-bar-tp-march is-forced" title="{{travelPoints.forcedTitle}}">
        <i class="fas fa-person-running-fast"></i>
      </span>
      {{/if}}{{/if}}
      {{#if travelPoints.hasBudget}}
      {{!-- Counts up, not down. Declaring a forced march raises the allowance,
            and a readout of what is left jumped by the whole difference at that
            click — 4/8 became 8/12 without a step having been walked. What has
            been spent does not change when the day gets longer. --}}
      {{#if isGM}}
      <button type="button" class="day-bar-tp-btn" data-action="spendTP" data-delta="-1"
              {{#unless travelPoints.spent}}disabled{{/unless}} title="Hand a Travel Point back">&minus;</button>
      {{/if}}
      <span class="day-bar-tp-value" title="{{travelPoints.budgetTitle}}">
        <strong class="{{#if travelPoints.over}}is-over{{/if}}">{{travelPoints.used}}</strong>/{{travelPoints.total}} TP
      </span>
      {{!-- The allowance silently shrinking by 2 would look like a bug. It says
            why. --}}
      {{#if travelPoints.weatherCost}}
      <span class="day-bar-tp-weather {{#if travelPoints.weatherStopped}}is-bad{{/if}}"
            title="{{travelPoints.budgetTitle}}">
        <i class="fas fa-cloud-showers-heavy"></i>&minus;{{travelPoints.weatherCost}}
      </span>
      {{/if}}
      {{#if isGM}}
      <button type="button" class="day-bar-tp-btn" data-action="spendTP" data-delta="1"
              {{#unless travelPoints.left}}disabled{{/unless}}
              title="Spend a Travel Point{{#if travelPoints.perPoint}} — {{travelPoints.perPoint}} of the day{{/if}}">+</button>
      {{/if}}
      {{!-- What a point costs the clock. Small and beside the counter, because
            it is the number that answers "can we still make it before dark?"
            and it changes only when the march does. --}}
      {{#if travelPoints.perPoint}}
      <span class="day-bar-tp-clock" title="{{travelPoints.budgetTitle}}">
        <i class="fas fa-clock"></i>{{travelPoints.perPoint}}
      </span>
      {{/if}}
      {{#if isGM}}
      <button type="button" class="day-bar-tp-refresh {{#if travelPoints.stale}}is-stale{{/if}}"
              data-action="refreshBudget" title="{{travelPoints.refreshTitle}}">
        <i class="fas fa-rotate"></i>
      </button>
      {{/if}}
      {{else}}
      <span class="day-bar-tp-value" title="{{travelPoints.budgetTitle}}">&mdash; TP</span>
      {{/if}}
    </div>
    {{#if weatherSlot}}
    {{!-- A fixed berth, held whether or not the day has been rolled for. A chip
          that appears out of nowhere shifts everything after it along the row,
          and "not yet" is itself worth seeing. --}}
    <span class="day-bar-weather {{#unless weather}}is-empty{{/unless}}" title="{{weatherTitle}}">
      <i class="fas {{weatherIcon}}"></i>
      <span class="day-bar-weather-text">{{#if weather}}{{weather}}{{else}}&mdash;{{/if}}</span>
    </span>
    {{/if}}
    {{#if showOwn}}
    {{!-- The third fixed unit: icons only, no names — a player knows whose
          characters these are. Both states are drawn, never only the done one:
          "not eaten" is the reading that matters. --}}
    <div class="day-bar-own">
      {{#each party}}
      <span class="day-bar-own-char" title="{{this.name}}{{#unless this.noPenalty}} &mdash; {{this.penaltyTitle}}{{/unless}}">
        <i class="fas fa-drumstick-bite {{#if this.ate}}is-on{{else}}is-off{{/if}}"
           title="{{this.name}}: {{#if this.ate}}has eaten today{{else}}has NOT eaten today{{/if}}"></i>
        <i class="fas fa-bed {{#if this.sleptWell}}is-on{{else}}is-off{{/if}}"
           title="{{this.name}}: {{#if this.sleptWell}}slept well{{else}}NO good night&#x27;s rest{{/if}}"></i>
        {{!-- The running total of hunger and exhaustion, beside the two things
              that cause it. The slot is kept even when there is nothing in it,
              so the unit does not change width the moment somebody goes hungry. --}}
        <span class="day-bar-own-penalty {{#unless this.noPenalty}}is-bad{{/unless}}"
              title="{{this.name}}: {{#if this.noPenalty}}no hunger or exhaustion penalty{{else}}{{this.penaltyTitle}}{{/if}}">
          {{#if this.noPenalty}}&mdash;{{else}}{{this.penalty}}{{/if}}
        </span>
      </span>
      {{/each}}
    </div>
    {{/if}}
    {{/unless}}

    {{!-- The other three windows of the module, so a day is run from one line
          instead of from here and the control bar. Outside the collapse, and
          fenced off by a rule: they are not part of the day's procedure. --}}
    {{!-- The same three the toolbar offers, and under the same settings: a
          player who may not open the Loot from the toolbar may not open it from
          here either. --}}
    <div class="day-bar-shortcuts">
      <button type="button" class="day-bar-icon-btn" data-action="openShortcut" data-shortcut="inventory"
              title="{{#if isGM}}Party Inventory{{else}}My Inventory{{/if}}">
        <i class="fas fa-backpack"></i>
      </button>
      {{!-- Same order as the scene toolbar (Leander, 2026-08-25): inventory,
            trash, shop, inn, loot. Two lists in two places that disagree about
            their order are two lists to learn. --}}
      {{!-- The sheet, for a player. Here as well as on the scene toolbar
            because BAR_ONLY_ACCESS takes the toolbar buttons away — a door that
            existed only there would vanish for a table using that setting, and
            that is exactly what happened when this one was first built. Not for
            the Referee, whose door is a button per member in the party
            window. --}}
      {{#unless isGM}}
      <button type="button" class="day-bar-icon-btn" data-action="openShortcut" data-shortcut="character"
              title="My attributes, saves, skills and traits">
        <i class="fas fa-scroll"></i>
      </button>
      {{/unless}}
      {{#if mayOpenTrash}}
      <button type="button" class="day-bar-icon-btn" data-action="openShortcut" data-shortcut="trash"
              title="Trash">
        <i class="fas fa-trash"></i>
      </button>
      {{/if}}
      {{!-- **A shut place is drawn, not hidden**, so that a player can see there
            is one and that it is not open yet (Leander, 2026-09-01). Disabled
            as well as faded: a door that looks shut and opens anyway is worse
            than either. --}}
      {{#if mayOpenShop}}
      <button type="button" class="day-bar-icon-btn {{#if shopShut}}is-shut{{/if}}"
              data-action="openShortcut" data-shortcut="shop" {{#if shopShut}}disabled{{/if}}
              title="{{#if shopShut}}The shop is closed{{else}}Shop{{/if}}">
        <i class="fas fa-store"></i>
      </button>
      {{/if}}
      {{#if mayOpenInn}}
      <button type="button" class="day-bar-icon-btn {{#if innShut}}is-shut{{/if}}"
              data-action="openShortcut" data-shortcut="inn" {{#if innShut}}disabled{{/if}}
              title="{{#if innShut}}The inn is closed{{else}}Inn{{/if}}">
        <i class="fas fa-beer-mug-empty"></i>
      </button>
      {{/if}}
      {{#if mayOpenLoot}}
      <button type="button" class="day-bar-icon-btn" data-action="openShortcut" data-shortcut="loot"
              title="Loot">
        <i class="fas fa-treasure-chest"></i>
      </button>
      {{/if}}
    </div>

    <div class="day-bar-right">
      {{#unless collapsed}}{{#if isGM}}
      <button type="button" class="day-bar-icon-btn" data-action="resetDay" title="Clear today's ticks and spent Travel Points without moving the day on">
        <i class="fas fa-rotate-left"></i>
      </button>
      {{/if}}{{/unless}}
      <button type="button" class="day-bar-icon-btn" data-action="toggleCollapsed"
              title="{{#if collapsed}}Unfold the bar{{else}}Fold the bar down to its handle{{/if}}">
        <i class="fas {{#if collapsed}}fa-angles-down{{else}}fa-angles-up{{/if}}"></i>
      </button>
      <button type="button" class="day-bar-icon-btn" data-action="hideBar" title="Hide the bar entirely (bring it back from the toolbar)">
        <i class="fas fa-xmark"></i>
      </button>
    </div>
  </div>

  {{!-- Where the party is. Every table below is rolled against it, and none of
        it can be derived — Foundry knows nothing of Dolmenwood's hexes or its
        calendar. The Referee's alone: a player's bar skips the whole band. --}}
  {{#unless collapsed}}
  {{#if isGM}}
  {{!-- Where the party is, in three kinds of thing rather than seven fields
        (Leander, 2026-08-31). They were one uniform grid, which made the field
        nobody ever touches look exactly like the one that is changed on every
        single move.

        **The hex stands on its own**, a block to the left of a dividing rule
        and two lines tall: the number, the crosshairs that teach the map to
        read it off the token, and the page it is written up on. It is not a
        setting among settings — it is the thing the two lines beside it are
        about (*"die Nummer, der Knopf zum kalibrieren und die seitenzahl sind
        ja irgendwie für sich stehend"*).

        **The first line to its right is what the book answers**, not the
        Referee: type the hex and Terrain and Region follow it out of the
        Campaign Book. Drawn back, because if all goes well nobody touches
        either of them all campaign — still editable on click, because a hex
        the book does not detail arrives with neither.

        **The second line is what the Referee sets, in the order it gets
        touched**: Way most often of anything here, Settlement a good deal
        less, Season a handful of times a year. The chance of losing the way
        closes that line, because it is what those settings add up to.

        The three dials keep a grid of equal columns, so a long town name
        cannot shuffle the field beside it sideways.

        What used to be here: a chevron, a summary reading "Autumn · Track ·
        Tangled forest · High Wold", and the five fields folded away behind it.
        Leander had all three out (2026-08-29) — the summary said what the
        fields said, and the fold hid the one field that changes every time the
        party moves. The hex's name and its foraging line went with them: the
        briefing card carries that into chat the moment the hex changes, and
        twice is once too often. --}}
  <div class="day-bar-row day-bar-context">

    <span class="day-bar-context-hex" title="{{context.hexHint}}">
      <label for="dw-ctx-hex">Hex</label>
      <span class="day-bar-hex-controls">
        <input type="text" id="dw-ctx-hex" data-context-field="hex" maxlength="5"
               inputmode="numeric" placeholder="0101" value="{{context.hex}}" />
        {{!-- Two measurements per map, and the hex reads itself off the token
              from then on. Beside the box because the box holds the other half
              of each one: the number the token is standing in. --}}
        {{#if context.mayCalibrate}}
        <button type="button" class="day-bar-hex-calibrate{{#if context.calibrated}} is-set{{/if}}{{#if context.calibrateHalf}} is-half{{/if}}"
                data-action="calibrateHex" title="{{context.calibrateTitle}}"
                aria-label="{{context.calibrateLabel}}">
          <i class="fas fa-crosshairs"></i>{{#if context.calibrateHalf}}<span class="day-bar-hex-calibrate-step">2</span>{{/if}}
        </button>
        {{/if}}
        {{#if context.hexName}}
        <a class="day-bar-hex-page dw-book-link" data-book="campaign" data-book-page="{{context.hexPage}}"
           title="{{context.hexName}} — open the Campaign Book at it.">p{{context.hexPage}}</a>
        {{/if}}
      </span>
    </span>

    <span class="day-bar-context-field is-derived day-bar-ctx-terrain" title="{{context.terrainHint}}">
      <label for="dw-ctx-terrain">Terrain</label>
      <select id="dw-ctx-terrain" data-context-field="terrain">
        {{#each context.terrainGroups}}
        <optgroup label="{{this.label}}">
          {{#each this.terrains}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </optgroup>
        {{/each}}
      </select>
    </span>

    <span class="day-bar-context-field is-derived day-bar-ctx-region" title="{{context.regionHint}}">
      <label for="dw-ctx-region">Region</label>
      <select id="dw-ctx-region" data-context-field="region">
        {{#each context.regions}}
        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </span>

    {{!-- The party crossed a hex boundary and the module could not tell which
          hex they came out in — not calibrated, off the book's map, or the
          reading switched off. Clicking says "still right" and drops it. It
          closes the line the hex answers, over the chance it did not. --}}
    {{#if context.moved}}
    <button type="button" class="day-bar-context-moved" data-action="confirmContext"
            title="{{context.moved.title}}">
      <i class="fas fa-triangle-exclamation"></i>
      <span>{{context.moved.label}}</span>
    </button>
    {{/if}}

    {{!-- Every move, near enough: the ground underfoot is the one thing here
          that changes with the leg rather than with the hex. --}}
    <span class="day-bar-context-field day-bar-ctx-way" title="{{context.wayHint}}">
      <label for="dw-ctx-way">Way</label>
      <select id="dw-ctx-way" data-context-field="way">
        {{#each context.ways}}
        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </span>

    {{!-- Kept apart from the region, because a party can be in a town and in a
          region and true at the same time. Only the Settlement tab rolls on it. --}}
    <span class="day-bar-context-field day-bar-ctx-settlement" title="{{context.settlementHint}}">
      <label for="dw-ctx-settlement">Settlement</label>
      <select id="dw-ctx-settlement" data-context-field="settlement">
        {{#each context.settlements}}
        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </span>

    <span class="day-bar-context-field day-bar-ctx-season" title="{{context.seasonHint}}">
      <label for="dw-ctx-season">Season</label>
      <select id="dw-ctx-season" data-context-field="season">
        {{#each context.seasons}}
        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </span>

    <span class="day-bar-context-lost" title="{{context.lostTitle}}">{{context.lostLine}}</span>
  </div>
  {{/if}}
  {{/unless}}

  {{#unless collapsed}}
  {{#if isGM}}
  {{!-- The duty list and the party tallies are both the Referee’s. A player’s
        own eating and sleeping moved up to the top line, so this row would be
        an empty band on their bar. --}}
  <div class="day-bar-row day-bar-duties">
    {{#if isGM}}
    {{#each blocks}}
    {{#if this.groupId}}
    {{!-- Making camp is one job done in one stretch, so it takes one tick here
          and opens its seven steps in a window of their own. --}}
    <button type="button" class="day-bar-duty day-bar-group-chip {{#if this.allDone}}is-done{{/if}}"
            data-action="openGroup" data-group-id="{{this.groupId}}"
            title="{{this.groupLabel}} — {{this.doneCount}} of {{this.total}} steps done. Click for the steps.">
      <i class="fas {{#if this.allDone}}fa-square-check{{else}}fa-square{{/if}} day-bar-tick"></i>
      <i class="fas {{this.groupIcon}} day-bar-duty-icon"></i>
      <span class="day-bar-duty-label">{{this.groupLabel}}</span>
      <span class="day-bar-group-count">{{this.doneCount}}/{{this.total}}</span>
    </button>
    {{else}}
    {{#each this.duties}}
    {{> dayBarDuty}}
    {{/each}}
    {{/if}}
    {{/each}}
    {{/if}}

    {{!-- The party's own tallies ride at the right end of the duty line rather
          than on a row of their own: three or four chips never filled a line,
          and the bar is shorter for it. --}}
    {{#if hasParty}}
    {{#if isGM}}
    <div class="day-bar-party">
      <button type="button" class="day-bar-chip {{#if allAte}}is-done{{/if}}"
              data-action="togglePanel"
              title="Characters who have eaten today. Everyone needs a ration a day — hunger costs -1 Attack from day one and 1 Constitution a day from day seven (Player's Book p153).">
        <i class="fas fa-drumstick-bite"></i> {{ateCount}}/{{partySize}}
      </button>
      <button type="button" class="day-bar-chip {{#if allSlept}}is-done{{/if}}"
              data-action="togglePanel"
              title="Characters who got a GOOD night's rest. Anything less leaves them exhausted until they do (Player's Book p159).">
        <i class="fas fa-bed"></i> {{sleptCount}}/{{partySize}}
      </button>
      {{#if warnings}}
      <button type="button" class="day-bar-chip is-warning" data-action="togglePanel"
              title="{{warningsTitle}}">
        <i class="fas fa-heart-crack"></i> {{warnings}}
      </button>
      {{/if}}
      <button type="button" class="day-bar-icon-btn" data-action="togglePanel"
              title="{{#if panelOpen}}Fold the party away{{else}}Show each character{{/if}}">
        <i class="fas {{#if panelOpen}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
      </button>
    </div>
    {{/if}}
    {{/if}}
  </div>
  {{/if}}
  {{/unless}}


</div>

{{#unless collapsed}}
{{#if panelOpen}}
{{#if hasParty}}
{{!-- Hunger, sleep and exhaustion land on individual characters, not the party,
      so this is where they are read and set. --}}
{{#if isGM}}
<div class="day-bar-panel">
  <div class="day-bar-panel-head">
    <span class="day-bar-panel-name">Character</span>
    <span class="day-bar-panel-col">Ate</span>
    <span class="day-bar-panel-col">Slept well</span>
    <span class="day-bar-panel-col">Hunger</span>
    <span class="day-bar-panel-col">No sleep</span>
    <span class="day-bar-panel-col">No rest</span>
    <span class="day-bar-panel-col day-bar-panel-penalty-head">Penalty</span>
  </div>
  {{#each party}}
  <div class="day-bar-panel-row">
    <span class="day-bar-panel-name">
      {{this.name}}
      {{#unless this.hasFood}}<i class="fas fa-utensils-slash day-bar-nofood" title="Carrying nothing edible"></i>{{/unless}}
    </span>

    {{#if ../isGM}}
    <button type="button" class="day-bar-panel-tick {{#if this.ate}}is-on{{/if}}"
            data-action="toggleAte" data-actor-id="{{this.actorId}}" data-value="{{this.ate}}"
            title="Eating a ration from the inventory or a meal at an inn ticks this by itself">
      <i class="fas {{#if this.ate}}fa-square-check{{else}}fa-square{{/if}}"></i>
    </button>
    {{else}}
    <span class="day-bar-panel-tick {{#if this.ate}}is-on{{/if}}">
      <i class="fas {{#if this.ate}}fa-square-check{{else}}fa-square{{/if}}"></i>
    </span>
    {{/if}}

    {{#if ../isGM}}
    <button type="button" class="day-bar-panel-tick {{#if this.sleptWell}}is-on{{/if}}"
            data-action="toggleSlept" data-actor-id="{{this.actorId}}" data-value="{{this.sleptWell}}"
            title="A GOOD night's rest, not merely lying down: easy conditions are automatic, moderate and difficult ones need a Constitution Check, impossible ones fail outright (Player's Book p159). Paying for lodging at an inn ticks this by itself.">
      <i class="fas {{#if this.sleptWell}}fa-square-check{{else}}fa-square{{/if}}"></i>
    </button>
    {{else}}
    <span class="day-bar-panel-tick {{#if this.sleptWell}}is-on{{/if}}">
      <i class="fas {{#if this.sleptWell}}fa-square-check{{else}}fa-square{{/if}}"></i>
    </span>
    {{/if}}

    <span class="day-bar-panel-col {{#if this.hungry}}is-bad{{/if}}"
          title="{{#if this.hungry}}Days without food. -1 Attack from day one, -10 Speed from day two, 1 Constitution a day from day seven.{{else}}Fed{{/if}}">
      {{#if this.hungry}}{{this.daysWithoutFood}}{{else}}&mdash;{{/if}}
    </span>

    <span class="day-bar-panel-col {{#if this.tired}}is-bad{{/if}}"
          title="{{#if this.tired}}Days without a good night's rest. Exhausted until they get one: -1 to Attack and Damage Rolls per day, and a 1-in-6 chance of each prepared spell failing.{{else}}Rested{{/if}}">
      {{#if this.tired}}{{this.daysWithoutSleep}}{{else}}&mdash;{{/if}}
    </span>

    {{#if ../isGM}}
    <button type="button" class="day-bar-panel-col day-bar-panel-rest {{#if this.overdue}}is-bad{{/if}}"
            data-action="restChar" data-actor-id="{{this.actorId}}"
            title="Travel days since this character last rested. The counter rises on every day the party spends a Travel Point, and clears on a day it spends none and this character sleeps well. A week is six travel days and one of rest, so the seventh travel day without one costs -1 to Attack and Damage Rolls until it is taken (Player's Book p157). A forced march owes its rest day at once. Click to clear both by hand.">
      {{this.travelDaysSinceRest}}/{{../restLimit}}{{#if this.forcedMarchesSinceRest}}<i class="fas fa-person-running-fast day-bar-forced-flag" title="Forced marches since the last rest day"></i>{{this.forcedMarchesSinceRest}}{{/if}}
    </button>
    {{else}}
    <span class="day-bar-panel-col day-bar-panel-rest {{#if this.overdue}}is-bad{{/if}}">{{this.travelDaysSinceRest}}/{{../restLimit}}</span>
    {{/if}}

    {{!-- One figure, both clocks. Hunger and exhaustion both hit the Attack Roll,
          so adding them is what the character actually rolls with; where it comes
          from is on hover. --}}
    <span class="day-bar-panel-penalty {{#unless this.noPenalty}}is-bad{{/unless}}"
          title="{{#if this.noPenalty}}No hunger or exhaustion penalty{{else}}{{this.penaltyTitle}}{{/if}}">
      {{#if this.noPenalty}}&mdash;{{else}}{{this.penalty}}{{/if}}
    </span>
  </div>
  {{/each}}
</div>
{{/if}}
{{/if}}
{{/if}}
{{/unless}}

</div>
