<div class="xp-window-inner">

  {{!-- **Every string in this file comes out of `lang/*.json`.** Foundry ships
        `{{localize "KEY"}}`, and `{{localize "KEY" a=1}}` formats placeholders;
        `{{localizeN "KEY" n}}` picks singular or plural — see `helpers/i18n.ts`.
        A triple stache is used only where the key deliberately carries markup
        (<kbd>, <strong>): those strings are authored here, never user input. --}}

  <div class="dw-window-head">
    <i class="fas fa-star"></i>
    <h2>{{localize "DOLMENWOOD.Xp.Title"}}</h2>
    <div class="dw-window-head-extra">
      <div class="xp-mode">
        <button type="button" class="xp-mode-btn {{#if isSplit}}is-on{{/if}}"
                data-action="setMode" data-mode="split"
                title="{{localize "DOLMENWOOD.Xp.Mode.Split.Hint"}}">
          <i class="fas fa-divide"></i> {{localize "DOLMENWOOD.Xp.Mode.Split.Label"}}
        </button>
        <button type="button" class="xp-mode-btn {{#unless isSplit}}is-on{{/unless}}"
                data-action="setMode" data-mode="each"
                title="{{localize "DOLMENWOOD.Xp.Mode.Each.Hint"}}">
          <i class="fas fa-user-pen"></i> {{localize "DOLMENWOOD.Xp.Mode.Each.Label"}}
        </button>
      </div>
    </div>
  </div>

  {{!-- **One band, both modes.** The switch above changes what is inside it and
        not how tall it is, so the table below does not move under the cursor
        when you press it. --}}
  <div class="xp-total-band">
    {{#if isSplit}}
    <label class="xp-total-label" for="xp-total">{{localize "DOLMENWOOD.Xp.Total.Label"}}</label>
    <input id="xp-total" class="xp-total-input" type="number" min="0" step="1"
           data-xp-field="total" value="{{total}}" autocomplete="off">
    <span class="xp-total-note">
      {{localizeN "DOLMENWOOD.Xp.Total.Note" countIn}}
      {{{localize "DOLMENWOOD.Xp.Total.Reckon"}}}
    </span>
    {{#if remainder}}
    <span class="xp-remainder" title="{{localize "DOLMENWOOD.Xp.Remainder.Hint"}}">
      <i class="fas fa-circle-info"></i> {{localize "DOLMENWOOD.Xp.Remainder.Label" n=remainder}}
    </span>
    {{/if}}
    {{#if overspent}}
    <span class="xp-remainder is-over" title="{{localize "DOLMENWOOD.Xp.Overspent.Hint"}}">
      <i class="fas fa-triangle-exclamation"></i> {{localize "DOLMENWOOD.Xp.Overspent.Label" n=overspent}}
    </span>
    {{/if}}
    {{else}}
    <span class="xp-total-label">{{localize "DOLMENWOOD.Xp.Mode.Each.Label"}}</span>
    <span class="xp-hint">
      <i class="fas fa-circle-info"></i>
      {{localize "DOLMENWOOD.Xp.Each.Hint"}}
    </span>
    {{/if}}
  </div>

  {{#if hasRows}}
  <div class="xp-table">

    <div class="xp-row xp-row-head">
      <span class="xp-lane-tick"></span>
      <span class="xp-lane-name">{{localize "DOLMENWOOD.Xp.Lane.Character"}}</span>
      <span class="xp-lane-base">{{#if isSplit}}{{localize "DOLMENWOOD.Xp.Lane.Share"}}{{else}}{{localize "DOLMENWOOD.Xp.Lane.Earned"}}{{/if}}</span>
      <span class="xp-lane-mod">{{localize "DOLMENWOOD.Xp.Lane.Modifier"}}</span>
      <span class="xp-lane-award">{{localize "DOLMENWOOD.Xp.Lane.Credited"}}</span>
      <span class="xp-lane-total">{{localize "DOLMENWOOD.Xp.Lane.NewTotal"}}</span>
      <span class="xp-lane-reset"></span>
    </div>

    {{#each rows}}
    <div class="xp-row {{#unless this.included}}is-out{{/unless}}">

      <span class="xp-lane-tick">
        <input type="checkbox" data-xp-field="include" data-actor-id="{{this.actorId}}"
               {{#if this.included}}checked{{/if}}
               title="{{localize "DOLMENWOOD.Xp.Row.Include.Hint"}}">
      </span>

      <span class="xp-lane-name">
        <span class="xp-name">{{this.name}}</span>
        <span class="xp-sub" title="{{this.primeTitle}}">
          {{#if this.classLabel}}
            {{this.classLabel}} &middot; {{this.primeLabel}}
          {{else if this.className}}
            <em>{{this.className}}</em> &middot; {{localize "DOLMENWOOD.Xp.Row.UnknownClass"}}
          {{else}}
            <em>{{localize "DOLMENWOOD.Xp.Row.NoClass"}}</em>
          {{/if}}
          {{#if this.isHalfShare}}
          <span class="xp-half" title="{{localize "DOLMENWOOD.Xp.Row.Share.Hint" pct=this.sharePct}}">
            <i class="fas fa-scale-unbalanced"></i> {{this.sharePct}}%
          </span>
          {{/if}}
        </span>
      </span>

      <span class="xp-lane-base">
        <input type="number" step="1" class="xp-base-input {{#if this.overridden}}is-hand-set{{/if}}"
               data-xp-field="base" data-actor-id="{{this.actorId}}" value="{{this.base}}"
               {{#unless this.included}}disabled{{/unless}} autocomplete="off">
      </span>

      <span class="xp-lane-mod">
        {{#if this.percentEditable}}
        <input type="number" step="1" class="xp-percent-input" data-xp-field="percent"
               data-actor-id="{{this.actorId}}" value="{{this.percent}}" autocomplete="off"
               title="{{localize "DOLMENWOOD.Xp.Row.Percent.Hint"}}">
        <span class="xp-percent-sign">%</span>
        {{else}}
        <span class="xp-percent-chip {{#if (lt this.percent 0)}}is-bad{{/if}} {{#if (gt this.percent 0)}}is-good{{/if}}"
              title="{{this.primeTitle}}">{{this.percentText}}</span>
        {{/if}}
      </span>

      <span class="xp-lane-award">
        {{#if this.included}}
        <strong class="xp-award {{#if (lt this.award.award 0)}}is-bad{{/if}}">
          {{#if (gte this.award.award 0)}}+{{/if}}{{this.award.award}}
        </strong>
        {{else}}
        <span class="xp-none">—</span>
        {{/if}}
      </span>

      <span class="xp-lane-total">
        <span class="xp-from">{{this.current}}</span>
        <i class="fas fa-arrow-right xp-arrow"></i>
        <span class="xp-to">{{this.award.newTotal}}</span>
        {{#if this.award.levelUp}}
        {{!-- "May", not "does": by the house rules a Level is trained for, paid
              for and takes time. This card only says the threshold is passed. --}}
        <span class="xp-levelup" title="{{localize "DOLMENWOOD.Xp.Row.LevelUp.Hint" next=this.next}}">
          <i class="fas fa-angles-up"></i> {{localize "DOLMENWOOD.Xp.Row.LevelUp.Label"}}
        </span>
        {{/if}}
        {{#if this.capLost}}
        <span class="xp-capped" title="{{localize "DOLMENWOOD.Xp.Row.Capped.Hint" at=this.capAt lost=this.capLost}}">
          <i class="fas fa-hand"></i> {{localize "DOLMENWOOD.Xp.Row.Capped.Label" lost=this.capLost}}
        </span>
        {{/if}}
      </span>

      <span class="xp-lane-reset">
        {{#if this.overridden}}
        <button type="button" class="icon-btn" data-action="resetRow" data-actor-id="{{this.actorId}}"
                title="{{localize "DOLMENWOOD.Xp.Row.Reset.Hint"}}">
          <i class="fas fa-rotate-left"></i>
        </button>
        {{/if}}
      </span>

    </div>
    {{/each}}
  </div>
  {{else}}
  <p class="xp-empty">
    <i class="fas fa-star"></i>
    <em>{{localize "DOLMENWOOD.Xp.Empty"}}</em>
  </p>
  {{/if}}

  <footer class="xp-footer">
    <label class="xp-chat">
      <input type="checkbox" data-xp-field="toChat" {{#if toChat}}checked{{/if}}>
      {{localize "DOLMENWOOD.Xp.Announce"}}
    </label>

    <span class="xp-footer-sum">
      {{#if canAward}}
      {{{localizeN "DOLMENWOOD.Xp.Footer.Sum" countIn awarded=awarded}}}
      {{#if levelUps}}
      <span class="xp-levelup-note" title="{{levelUpNames}}">
        <i class="fas fa-angles-up"></i> {{localize "DOLMENWOOD.Xp.Footer.LevelUps" n=levelUps}}
      </span>
      {{/if}}
      {{else}}
      <span class="xp-none">{{localize "DOLMENWOOD.Xp.Footer.Nothing"}}</span>
      {{/if}}
    </span>

    <button type="button" class="btn-toolbar" data-action="clearAll" title="{{localize "DOLMENWOOD.Xp.Clear.Hint"}}">
      <i class="fas fa-eraser"></i> {{localize "DOLMENWOOD.Xp.Clear.Label"}}
    </button>
    <button type="button" class="btn-toolbar xp-award-btn" data-action="award" {{#unless canAward}}disabled{{/unless}}>
      <i class="fas fa-star"></i> {{localize "DOLMENWOOD.Xp.Award"}}
    </button>
  </footer>

</div>
