<div class="inn-panel">

  {{!-- Header --}}
  <div class="inn-header">
    {{!-- The same head as every other window of this module (Dolmenmaster,
          2026-08-31: the inn "sieht komplett anders aus oben"). The Referee's
          name field is the title rather than a form control that happens to
          sit where a title goes — it looks like the heading it stands in for
          until it is clicked. --}}
    <div class="inn-title-row dw-window-head">
      <i class="fas fa-beer-mug-empty"></i>
      {{#if isGM}}
      <input type="text" id="inn-name-input" class="inn-name-edit dw-title-input" value="{{innName}}"
             placeholder="{{localize "DOLMENWOOD.Inn.Name.Placeholder"}}" title="{{localize "DOLMENWOOD.Inn.Name.Hint"}}" />
      {{else}}
      <h2 class="inn-name-static">{{displayName}}</h2>
      {{/if}}
      <span class="dw-window-head-extra">
        {{#if (neq priceFactor 100)}}<span class="price-factor-badge" title="{{localize "DOLMENWOOD.Inn.PriceFactor.Hint" pct=priceFactor}}">{{priceFactor}}%</span>{{/if}}
        {{!-- Quality: switchable only for the toolbar inn. A placed inn's
              quality was decided when it was put on the map and does not
              change. --}}
        {{#if canSetQuality}}
        <div class="quality-buttons">
          {{#each qualities}}
          <button type="button" class="quality-btn {{#if this.active}}active{{/if}}"
                  data-action="setQuality" data-quality="{{this.key}}">{{this.label}}</button>
          {{/each}}
        </div>
        {{else}}
        <span class="inn-quality-label" title="{{localize "DOLMENWOOD.Inn.QualityFixed.Hint"}}">{{qualityLabel}}</span>
        {{/if}}

        {{!-- **Last in the head, because it is the last thing done here**: name
              it, grade it, then let the party in (Dolmenmaster, 2026-08-31). Only
              the toolbar inn has this — an inn on the map is opened by its own
              note, and Foundry already decides who can see one. --}}
        {{#if canRelease}}
        <button type="button" class="dw-release-btn {{#if released}}is-released{{else}}is-staged{{/if}}"
                data-action="toggleRelease"
                title="{{#if released}}{{localize "DOLMENWOOD.Inn.Release.Open.Hint"}}{{else}}{{localize "DOLMENWOOD.Inn.Release.Closed.Hint"}}{{/if}}">
          <i class="fas {{#if released}}fa-door-open{{else}}fa-door-closed{{/if}}"></i>
          {{#if released}}{{localize "DOLMENWOOD.Inn.Release.Open.Label"}}{{else}}{{localize "DOLMENWOOD.Inn.Release.Closed.Label"}}{{/if}}
        </button>
        {{/if}}
      </span>
    </div>

    {{!-- Paying character + wallet --}}
    <div class="inn-actor-row">
      {{#if (gt actors.length 1)}}
      <select id="inn-actor-select" class="inn-actor-select" title="{{localize "DOLMENWOOD.Inn.Payer.Hint"}}">
        {{#each actors}}
        <option value="{{this.id}}" {{#if (eq this.id ../selectedActorId)}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
      {{else}}
      <span class="inn-actor-name">{{selectedActorName}}</span>
      {{/if}}
      <span class="inn-wallet">
        <i class="fas fa-coins"></i>
        {{coinTotal coins.cp coins.sp coins.gp coins.pp}}
      </span>
    </div>
  </div>

  {{!-- Who has eaten and slept today --}}
  <div class="inn-daybox">
    <div class="inn-daybox-header">
      <span class="inn-day-label"><i class="fas fa-sun"></i> {{localize "DOLMENWOOD.Inn.Today"}}</span>
      {{#if isGM}}
      <span class="inn-daybox-tools">
        <button type="button" class="icon-btn" data-action="rerollMenu" title="{{localize "DOLMENWOOD.Inn.Reroll.Hint"}}">
          <i class="fas fa-dice"></i>
        </button>
        <button type="button" class="btn-new-day" data-action="newDay" title="{{localize "DOLMENWOOD.Inn.NewDay.Hint"}}">
          <i class="fas fa-rotate"></i> {{localize "DOLMENWOOD.Inn.NewDay.Label"}}
        </button>
      </span>
      {{/if}}
    </div>
    {{#if dayLog.length}}
    <table class="inn-daybox-table">
      <thead>
        <tr><th>{{localize "DOLMENWOOD.Inn.Col.Character"}}</th><th>{{localize "DOLMENWOOD.Inn.Col.Lodging"}}</th><th>{{localize "DOLMENWOOD.Inn.Col.Food"}}</th></tr>
      </thead>
      <tbody>
        {{#each dayLog}}
        <tr class="{{#if this.complete}}is-complete{{/if}}">
          <td class="dl-name">{{this.name}}</td>
          <td class="{{#unless this.lodging}}dl-missing{{/unless}}">{{#if this.lodging}}{{this.lodging}}{{else}}—{{/if}}</td>
          <td class="{{#unless this.food}}dl-missing{{/unless}}">{{#if this.food}}{{this.food}}{{else}}—{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="inn-empty">{{localize "DOLMENWOOD.Inn.NoParty"}}</p>
    {{/if}}
  </div>

  {{!-- The menu --}}
  <div class="inn-menu">
    {{#each sections}}
    <details class="inn-section" data-sync="inn-section-{{this.key}}" open>
      <summary class="inn-section-header">
        <i class="fas {{this.icon}}"></i> {{this.label}}
        {{#if this.showQuality}}<span class="inn-section-quality" title="{{localize "DOLMENWOOD.Inn.Section.Quality.Hint"}}">{{this.qualityLabel}}</span>{{/if}}
      </summary>

      {{#if this.canEdit}}
      <div class="inn-section-tools">
        <button type="button" class="icon-btn" data-action="editSection" data-section="{{this.key}}" title="{{localize "DOLMENWOOD.Inn.Section.Edit.Hint"}}">
          <i class="fas fa-sliders"></i>
        </button>
        <button type="button" class="icon-btn" data-action="addEntry" data-section="{{this.key}}" title="{{localize "DOLMENWOOD.Inn.Section.Add.Hint"}}">
          <i class="fas fa-plus"></i>
        </button>
        <button type="button" class="icon-btn" data-action="resetSection" data-section="{{this.key}}" title="{{localize "DOLMENWOOD.Inn.Section.Reset.Hint"}}">
          <i class="fas fa-arrow-rotate-left"></i>
        </button>
      </div>
      {{/if}}

      {{#if this.text}}<p class="inn-section-text">{{this.text}}</p>{{/if}}

      {{#each this.groups}}
      {{#if this.label}}<div class="inn-group-label">{{this.label}}</div>{{/if}}
      <div class="inn-item-list">
        {{#each this.entries}}
        <div class="inn-item {{#unless this.canAfford}}inn-item-unaffordable{{/unless}}">
          <div class="inn-item-info">
            <span class="inn-item-name">
              {{#if this.fixed}}<i class="fas fa-star inn-fixed-marker" title="{{localize "DOLMENWOOD.Inn.Item.Fixed.Hint"}}"></i> {{/if}}{{this.name}}
              {{#if this.tag}}<span class="inn-item-tag">{{this.tag}}</span>{{/if}}
              {{!-- The pricing basis ("per person") lives beside the name, not
                    in the price column — there it either wrapped to a second
                    line or forced the column wide enough to push the numbers
                    away from the buttons. --}}
              {{#if this.unit}}<span class="inn-item-tag inn-item-unit">{{this.unit}}</span>{{/if}}
            </span>
            {{#if this.description}}<span class="inn-item-desc">{{this.description}}</span>{{/if}}
          </div>

          <span class="inn-item-cost">{{this.cost.amount}} {{this.cost.currencyLabel}}</span>

          {{!-- Everything after the price sits in one column so the rows line up,
                whether a line has one button or four --}}
          <div class="inn-item-actions">
          {{#if this.canEdit}}
          <button type="button" class="icon-btn" data-action="editEntry"
                  data-section="{{this.section}}" data-entry-id="{{this.id}}" title="{{localize "DOLMENWOOD.Inn.Item.Edit.Hint"}}">
            <i class="fas fa-pen"></i>
          </button>
          <button type="button" class="icon-btn" data-action="deleteEntry"
                  data-section="{{this.section}}" data-entry-id="{{this.id}}" title="{{localize "DOLMENWOOD.Inn.Item.Delete.Hint"}}">
            <i class="fas fa-trash"></i>
          </button>
          {{/if}}

          {{!-- Every row renders the same slots in the same order, so a kind of
                button always sits in the same column. A line that does not offer
                one leaves its slot empty rather than letting the rest slide over. --}}

          {{!-- Consumed on the spot: for me, or standing a round --}}
          {{#if this.consumable}}
          <button type="button" class="btn-inn-purchase" data-action="buyForSelf"
                  data-section="{{this.section}}" data-entry-id="{{this.id}}"
                  {{#unless this.canAfford}}disabled title="{{localize "DOLMENWOOD.Inn.CannotAfford"}}"{{else}}title="{{this.buyLabel}}"{{/unless}}>
            <i class="fas fa-user"></i>
          </button>
          <button type="button" class="btn-inn-purchase btn-inn-treat" data-action="buyForOther"
                  data-section="{{this.section}}" data-entry-id="{{this.id}}"
                  {{#unless this.canAfford}}disabled title="{{localize "DOLMENWOOD.Inn.CannotAfford"}}"{{else}}title="{{localize "DOLMENWOOD.Inn.BuyForOther.Hint"}}"{{/unless}}>
            <i class="fas fa-people-group"></i>
          </button>
          {{else}}
          <span class="inn-action-empty"></span>
          <span class="inn-action-empty"></span>
          {{/if}}

          {{!-- Carried away: a bottle, a cask, or goods such as rations --}}
          {{#if this.takeAway}}
          <button type="button" class="btn-inn-purchase btn-inn-container" data-action="buyContainer"
                  data-section="{{this.section}}" data-entry-id="{{this.id}}"
                  {{#unless this.takeAway.canAfford}}disabled title="{{localize "DOLMENWOOD.Inn.CannotAfford"}}"{{else}}title="{{this.takeAway.title}}"{{/unless}}>
            <i class="fas {{this.takeAway.icon}}"></i>
          </button>
          {{else}}
          <span class="inn-action-empty"></span>
          {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{/each}}

      {{#if this.isEmpty}}<p class="inn-empty">{{localize "DOLMENWOOD.Inn.Empty"}}</p>{{/if}}
    </details>
    {{/each}}
  </div>

</div>
